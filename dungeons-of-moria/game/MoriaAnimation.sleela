#sleela 1.6
//
// Moria — the Walk Animation
// ==========================
// The character animation sampled as START -> MID -> STOP: the three poses the
// autocropped sprite sheets slice into (see moria/images/<character>/, produced
// by tools/autocrop_sprites.py). This module drives a figure's walk from those
// three frames and advances its on-board position so it reads as WALKING.
//
// The sprite frames themselves are PNGs on disk; here we model which frame is
// shown at each tick and where the walker stands, so the SleelaUI front-end can
// bind frame -> SLImage and the headless read can narrate the gait. The frame
// files are named <character>-start.png / -mid.png / -stop.png, autocropped and
// sized to the sheet; frameLabel()/framePath() name them for a given tick.
//
// Determinism: the walk cycle is a pure function of the tick, so a replay shows
// the same gait every time. #sleela 1.6: scalars + struct, no arrays.

// One walking actor: a character animated across the three sampled frames while
// its (x,y) advances along a heading. Reference struct (intrusive list-ready).
struct Walker {
    String character;   // "adventurer", "warden", ...
    int    x;           // board column (in cells)
    int    y;           // board row
    int    headingX;    // PERSISTENT facing on x: -1 left, +1 right (never 0)
    int    headingY;    // last facing on y: -1 / 0 / +1
    int    moveX;        // this step's motion on x: -1 / 0 / +1
    int    moveY;        // this step's motion on y: -1 / 0 / +1
    int    tick;        // animation tick (advances each step)
    int    distance;    // total cells walked
    boolean moving;     // true while walking (START/MID), false at rest (STOP)
    Walker next;
}

class MoriaAnimation {

    // The animation sample: exactly three frames, in order.
    static int FRAME_START = 0;   // weight on the back foot, about to stride
    static int FRAME_MID   = 1;   // mid-stride, both feet off the line
    static int FRAME_STOP  = 2;   // weight settling, the foot planting
    static int FRAMES      = 3;

    // Walk-cycle timing. A full stride is START -> MID -> STOP -> MID -> (repeat)
    // so the gait reads as a loop; the "times" below are frame holds in ticks.
    static int HOLD_START = 2;
    static int HOLD_MID   = 1;
    static int HOLD_STOP  = 2;
    static int CYCLE      = 6;    // HOLD_START + HOLD_MID + HOLD_STOP + HOLD_MID

    // --- make / configure a walker -----------------------------------------
    // NB: named spawnWalker, not spawn: `spawn` is a reserved SLeeLa built-in
    // (the one-arg thread spawn), so a user method named `spawn` is shadowed.
    Walker spawnWalker(String character, int x, int y) {
        Walker w = new Walker();
        w.character = character;
        if (w.character == null) { w.character = "adventurer"; }
        w.x = x; w.y = y;
        w.headingX = 1; w.headingY = 0;   // facing east (right) by default
        w.moveX = 0; w.moveY = 0;
        w.tick = 0; w.distance = 0;
        w.moving = false;
        return w;
    }

    // Point the walker at a delta: set this step's MOTION (moveX/moveY) and the
    // PERSISTENT horizontal FACING (headingX, which never goes to 0, so a figure
    // walking straight up or down keeps looking the way it last turned).
    void face(Walker w, int dx, int dy) {
        w.moveX = sign(dx);
        w.moveY = sign(dy);
        if (w.moveX != 0) { w.headingX = w.moveX; }
        w.headingY = w.moveY;
    }

    int sign(int v) {
        if (v > 0) { return 1; }
        if (v < 0) { return 0 - 1; }
        return 0;
    }

    // Take one walking step: advance the tick (the gait) AND the position along
    // the heading. The character MOVES — like he's walking — one cell per step.
    void step(Walker w) {
        w.tick = w.tick + 1;
        w.moving = true;
        // If no motion was set, default to walking in the facing direction.
        if (w.moveX == 0 && w.moveY == 0) { w.moveX = w.headingX; }
        w.x = w.x + w.moveX;
        w.y = w.y + w.moveY;
        w.distance = w.distance + 1;
    }

    // Walk toward a target (tx,ty) by one step, setting the heading first.
    void stepToward(Walker w, int tx, int ty) {
        face(w, tx - w.x, ty - w.y);
        step(w);
    }

    // Come to rest: the gait settles on the STOP frame and motion stops.
    void halt(Walker w) {
        w.moving = false;
    }

    // --- which frame is showing right now -----------------------------------
    // The three-frame sample looped over the cycle:
    //   ticks [0,HOLD_START)              -> START
    //   next  [.., +HOLD_MID)             -> MID
    //   next  [.., +HOLD_STOP)            -> STOP
    //   next  [.., +HOLD_MID)             -> MID   (and repeat)
    int frameOf(Walker w) {
        if (!w.moving) { return FRAME_STOP; }   // at rest, show the planted pose
        int t = w.tick % CYCLE;
        if (t < HOLD_START) { return FRAME_START; }
        t = t - HOLD_START;
        if (t < HOLD_MID) { return FRAME_MID; }
        t = t - HOLD_MID;
        if (t < HOLD_STOP) { return FRAME_STOP; }
        return FRAME_MID;
    }

    String frameLabel(int frame) {
        if (frame == FRAME_START) { return "start"; }
        if (frame == FRAME_MID)   { return "mid"; }
        return "stop";
    }

    // Which way the walker FACES, left or right. Right = the sheet's own
    // orientation; left = the horizontally-mirrored sprite. A walker that is
    // moving purely up/down keeps its last horizontal facing (default right).
    String facing(Walker w) {
        if (w.headingX < 0) { return "left"; }
        return "right";
    }

    // The on-disk sprite file for a walker's current frame AND facing, e.g.
    // "images/adventurer/adventurer-mid-left.png". The SleelaUI build binds this
    // to an SLImage; all three poses x two facings were made by the autocropper.
    String framePath(Walker w) {
        String label = frameLabel(frameOf(w));
        String dir = facing(w);
        return "images/" + w.character + "/" + w.character
             + "-" + label + "-" + dir + ".png";
    }

    // The facing-neutral base frame (no -left/-right suffix), kept for callers
    // that do not care which way the figure looks.
    String frameBasePath(Walker w) {
        String label = frameLabel(frameOf(w));
        return "images/" + w.character + "/" + w.character + "-" + label + ".png";
    }

    // =======================================================================
    // Four-way directional sprites: top / down / left / right, with the frame
    // labelled start / mid / END (the designer's name for the planted pose —
    // the same frame frameLabel() calls "stop"). These address the full sprite
    // matrix under images/<character>/, e.g. gandalf-start-top.png. The
    // left/right facings mirror facing(); up and down come from the vertical
    // heading of THIS step's motion (headingY), falling back to the horizontal
    // facing when the figure is not moving vertically.
    // =======================================================================

    // The frame label using END for the planted pose (start / mid / end).
    String frameLabelEnd(int frame) {
        if (frame == FRAME_START) { return "start"; }
        if (frame == FRAME_MID)   { return "mid"; }
        return "end";
    }

    // Which of the four directions the walker faces: top / down / left / right.
    // Vertical motion wins (you face the way you step up/down); otherwise the
    // persistent horizontal facing (left/right) is used.
    String facing4(Walker w) {
        if (w.moveY < 0) { return "top"; }
        if (w.moveY > 0) { return "down"; }
        if (w.headingX < 0) { return "left"; }
        return "right";
    }

    // The on-disk sprite for the current frame AND four-way direction, named
    // with the END label, e.g. "images/gandalf/gandalf-mid-top.png".
    String framePath4(Walker w) {
        String label = frameLabelEnd(frameOf(w));
        String dir = facing4(w);
        return "images/" + w.character + "/" + w.character
             + "-" + label + "-" + dir + ".png";
    }

    // The directional sprite for an explicit (frame, direction) pair — handy
    // for a front-end that wants to show a specific pose without a Walker.
    // `frame` is FRAME_START/MID/STOP; `direction` is "top"/"down"/"left"/"right".
    String spritePath(String character, int frame, String direction) {
        String label = frameLabelEnd(frame);
        String dir = direction;
        if (dir == null) { dir = "down"; }
        return "images/" + character + "/" + character
             + "-" + label + "-" + dir + ".png";
    }

    // =======================================================================
    // NESTED directional/action folder layout:
    //   images/<character>/<direction>/<action>/<character>-<direction>-<action>.png
    // The same sprites as the flat layout, carefully filed under a folder per
    // facing (top/left/down/right) and a folder per action (start/mid/end).
    // These accessors resolve that tree so the folders "show up" in code too.
    // =======================================================================

    // The nested sprite for an explicit (frame, direction) pair.
    String nestedSpritePath(String character, int frame, String direction) {
        String action = frameLabelEnd(frame);     // start / mid / end
        String dir = direction;
        if (dir == null) { dir = "down"; }
        return "images/" + character + "/" + dir + "/" + action + "/"
             + character + "-" + dir + "-" + action + ".png";
    }

    // The nested sprite for a walker's current frame AND four-way direction.
    String framePath4Nested(Walker w) {
        return nestedSpritePath(w.character, frameOf(w), facing4(w));
    }

    // The folder that holds a direction's three action sprites, e.g.
    // "images/gandalf/left/". A front-end can list it to find start/mid/end.
    String directionFolder(String character, String direction) {
        String dir = direction;
        if (dir == null) { dir = "down"; }
        return "images/" + character + "/" + dir + "/";
    }

    // A heading word for the gait read — the direction of THIS step's motion.
    String headingWord(Walker w) {
        if (w.moveX > 0) { return "east"; }
        if (w.moveX < 0) { return "west"; }
        if (w.moveY > 0) { return "south"; }
        if (w.moveY < 0) { return "north"; }
        return "still";
    }

    // A one-line read of the walker's current animation state.
    String describe(Walker w) {
        String gait = "at rest";
        if (w.moving) { gait = "walking " + headingWord(w); }
        return w.character + " @ (" + w.x + "," + w.y + ") "
             + gait + " — frame " + frameLabel(frameOf(w))
             + " (tick " + w.tick + ", walked " + w.distance + " cells)";
    }

    // =======================================================================
    // A self-contained demo: walk a character eight cells east and narrate the
    // start/mid/stop gait at each step, then halt.
    // =======================================================================
    void main() {
        print("Moria — the Walk Animation (START -> MID -> STOP)");
        print("Frames per character: " + FRAMES
            + " (start, mid, stop); cycle " + CYCLE + " ticks.");
        print("");
        Walker hero = spawnWalker("adventurer", 2, 9);
        face(hero, 1, 0);
        print("Walking RIGHT (east) — uses the -right sprites:");
        int i = 0;
        while (i < 6) {
            step(hero);
            print("  " + describe(hero) + "   sprite=" + framePath(hero));
            i = i + 1;
        }
        print("");
        print("Turning and walking LEFT (west) — uses the -left (mirrored) sprites:");
        int j = 0;
        while (j < 6) {
            stepToward(hero, hero.x - 1, hero.y);   // face + step west
            print("  " + describe(hero) + "   sprite=" + framePath(hero));
            j = j + 1;
        }
        halt(hero);
        print("");
        print("At rest: " + describe(hero) + "   sprite=" + framePath(hero));

        // --- Gandalf: the full four-way directional sprite matrix -----------
        // top / down / left / right, each with start / mid / end — the sprites
        // under images/gandalf/. Walk him one step each way and read the frame.
        print("");
        print("Gandalf — four-way directional sprites (top/down/left/right):");
        Walker g = spawnWalker("gandalf", 5, 5);
        stepToward(g, g.x, g.y - 1);   // north -> top
        print("  up    -> " + framePath4(g));
        stepToward(g, g.x, g.y + 1);   // south -> down
        print("  down  -> " + framePath4(g));
        stepToward(g, g.x - 1, g.y);   // west  -> left
        print("  left  -> " + framePath4(g));
        stepToward(g, g.x + 1, g.y);   // east  -> right
        print("  right -> " + framePath4(g));
        print("  (frames: start/mid/end; e.g. "
            + spritePath("gandalf", FRAME_START, "top") + ", "
            + spritePath("gandalf", FRAME_MID, "left") + ", "
            + spritePath("gandalf", FRAME_STOP, "right") + ")");

        // The same sprites, filed in the nested <direction>/<action>/ folders.
        print("");
        print("Gandalf — nested direction/action folders:");
        print("  top/start -> " + nestedSpritePath("gandalf", FRAME_START, "top"));
        print("  left/mid  -> " + nestedSpritePath("gandalf", FRAME_MID, "left"));
        print("  down/end  -> " + nestedSpritePath("gandalf", FRAME_STOP, "down"));
        print("  right/end -> " + nestedSpritePath("gandalf", FRAME_STOP, "right"));

        // --- The whole cast: every character carries the same sprite set ----
        print("");
        print("The cast — each has the same four-way, three-action sprite set:");
        rosterSample("gandalf");
        rosterSample("gimli");
        rosterSample("frodo");
        rosterSample("aragorn");
        rosterSample("moria-goblin");
    }

    // Print one line sampling a character's mid-stride sprite each way (flat)
    // plus one nested path, to show the set is present and resolvable.
    void rosterSample(String character) {
        print("  " + character + ": "
            + spritePath(character, FRAME_MID, "top") + " | "
            + spritePath(character, FRAME_MID, "left") + " | "
            + spritePath(character, FRAME_MID, "down") + " | "
            + spritePath(character, FRAME_MID, "right")
            + "   nested e.g. " + nestedSpritePath(character, FRAME_START, "right"));
    }
}
