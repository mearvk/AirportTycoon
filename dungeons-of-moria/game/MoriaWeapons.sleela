#sleela 1.6
//
// Moria — The Armoury
// ===================
// The arms of the Mines, dressed up: a name-forge that composes THOUSANDS of
// distinct weapon names from a deterministic grammar
//
//     [Material] [Form] of [Legend]   (+N)
//
// With 20 materials x 28 forms x 24 legends the forge names 13,440 base weapons,
// each with an enchantment bonus (+N). MANY are +4 OR GREATER: the bonus is
// derived so the upper tiers of the catalog are richly enchanted, and the finds
// deep in Moria run +4..+9. Every name is stable for its index (determinism).
//
// No arrays: index -> String banks, and a forged weapon is a Weapon struct.

// One weapon (reference struct). Melee weapons leave the ranged fields at their
// defaults (ranged=false, range=1, diceCount=1, baseAdd=0) so every existing
// consumer that reads name/dieSides/bonus keeps working unchanged.
struct Weapon {
    int     id;       // stable catalog index
    String  name;     // the dressed-up name, bonus included
    int     dieSides; // damage die (d6, d8, d10, d12, ...)
    int     bonus;    // the +N enchantment (melee 0..9; ranged +3..+28)
    int     weight;   // a flavour weight class 1..5
    // --- ranged extension (crossbows and bows) ---
    boolean ranged;    // true for a bow or crossbow
    int     range;     // firing range in squares (ranged weapons: >= 8)
    int     diceCount; // number of damage dice (ranged bows/crossbows: 2)
    int     baseAdd;   // flat damage added before bonus (ranged set: +8)
}

class MoriaWeapons {

    static int MATERIALS = 20;
    static int FORMS     = 28;
    static int LEGENDS   = 24;
    // Catalog size = 20 * 28 * 24 = 13,440 distinct base weapons.

    // --- Settings (assumed on in settings somewhere) -----------------------
    // "+1 to hit or damage is MUTUAL": the +N enchantment adds to BOTH the
    // attack roll and the damage. This flag is the setting that makes it so.
    static int MUTUAL_PLUS = 1;        // 1 = mutual (default), 0 = damage only

    // --- The Mace: a signature weapon. Average 1d48 + 26 hit points. -------
    // 1d48 averages 24.5, so the Mace averages ~50.5 hp before STR/enchant.
    static int MACE_DIE   = 48;        // 1d48
    static int MACE_FLAT  = 26;        // + 26

    // --- The enchantment radius / depth model ------------------------------
    // A +N weapon carries an "incurrence radius" of extra-damage potential.
    // ANCHOR (by decree): a +5 weapon at Dungeon Depth 16 has ~256 radius
    // levels, i.e. ~1024 extra potential damage (= 256 x 4).
    //
    //   radiusBase(bonus) = 2^(bonus+3)         -> +5 => 2^8 = 256
    //       (so +4 => 128, +3 => 64, +2 => 32, ... a clean geometric falloff)
    //   depthMultiplier(depth) = REF_DEPTH / depth, clamped >= 1
    //       (LOWER depths are MORE GENEROUS; depth 16 is the reference x1)
    //   radiusLevels = radiusBase(bonus) * depthMultiplier(depth)
    //   extraPotential = radiusLevels * EXTRA_PER_RADIUS   (= x4 -> 1024)
    static int RADIUS_REF_DEPTH   = 16;  // the reference depth (x1 generosity)
    static int RADIUS_BASE_SHIFT  = 3;   // radiusBase = 2^(bonus + 3)
    static int EXTRA_PER_RADIUS   = 4;   // extra potential damage per radius level

    int catalogSize() { return MATERIALS * FORMS * LEGENDS; }

    String material(int i) {
        int k = i % MATERIALS;
        if (k == 0)  { return "Mithril"; }
        if (k == 1)  { return "Dwarf-steel"; }
        if (k == 2)  { return "Star-iron"; }
        if (k == 3)  { return "Black-iron"; }
        if (k == 4)  { return "Elven-silver"; }
        if (k == 5)  { return "Dragonbone"; }
        if (k == 6)  { return "Adamant"; }
        if (k == 7)  { return "Gold-runed"; }
        if (k == 8)  { return "Frost-forged"; }
        if (k == 9)  { return "Ember-forged"; }
        if (k == 10) { return "Moonstone"; }
        if (k == 11) { return "Obsidian"; }
        if (k == 12) { return "Ancient-bronze"; }
        if (k == 13) { return "Troll-cut"; }
        if (k == 14) { return "Deep-delved"; }
        if (k == 15) { return "Rune-etched"; }
        if (k == 16) { return "Sun-tempered"; }
        if (k == 17) { return "Shadow-quenched"; }
        if (k == 18) { return "Hallowed"; }
        return "Wyrmforged";
    }

    String form(int i) {
        int k = i % FORMS;
        if (k == 0)  { return "Longsword"; }
        if (k == 1)  { return "Warhammer"; }
        if (k == 2)  { return "Battleaxe"; }
        if (k == 3)  { return "Greatsword"; }
        if (k == 4)  { return "Mace"; }
        if (k == 5)  { return "Dagger"; }
        if (k == 6)  { return "Spear"; }
        if (k == 7)  { return "Halberd"; }
        if (k == 8)  { return "Flail"; }
        if (k == 9)  { return "Glaive"; }
        if (k == 10) { return "Mattock"; }
        if (k == 11) { return "Warpick"; }
        if (k == 12) { return "Scimitar"; }
        if (k == 13) { return "Maul"; }
        if (k == 14) { return "Rapier"; }
        if (k == 15) { return "Cleaver"; }
        if (k == 16) { return "Morningstar"; }
        if (k == 17) { return "Trident"; }
        if (k == 18) { return "Falchion"; }
        if (k == 19) { return "Broadaxe"; }
        if (k == 20) { return "Khopesh"; }
        if (k == 21) { return "Partisan"; }
        if (k == 22) { return "Zweihander"; }
        if (k == 23) { return "Hatchet"; }
        if (k == 24) { return "Longaxe"; }
        if (k == 25) { return "Warblade"; }
        if (k == 26) { return "Bardiche"; }
        return "Greataxe";
    }

    String legend(int i) {
        int k = i % LEGENDS;
        if (k == 0)  { return "Durin"; }
        if (k == 1)  { return "the Deep"; }
        if (k == 2)  { return "the Balrog-slayer"; }
        if (k == 3)  { return "Seven Fathers"; }
        if (k == 4)  { return "Khazad-dum"; }
        if (k == 5)  { return "the First Forge"; }
        if (k == 6)  { return "the Lonely Mountain"; }
        if (k == 7)  { return "Fallen Kings"; }
        if (k == 8)  { return "the Last Stand"; }
        if (k == 9)  { return "Riven Stone"; }
        if (k == 10) { return "the Silent Deep"; }
        if (k == 11) { return "the Molten Heart"; }
        if (k == 12) { return "Hidden Veins"; }
        if (k == 13) { return "the Watcher"; }
        if (k == 14) { return "the Bridge of Moria"; }
        if (k == 15) { return "the Elder Days"; }
        if (k == 16) { return "the Nameless Dark"; }
        if (k == 17) { return "the East Wind"; }
        if (k == 18) { return "the Undying Flame"; }
        if (k == 19) { return "the Threshold"; }
        if (k == 20) { return "Mithril Hall"; }
        if (k == 21) { return "the Dwarf-Lords"; }
        if (k == 22) { return "the Careful Years"; }
        return "Dawn's Edge";
    }

    // The enchantment bonus +N for a catalog index. Spread so MANY are +4 or
    // greater: the top ~40% of the catalog carry +4..+9, and deeper finds skew
    // high. 0..3 for the common, 4..9 for the fine and the legendary.
    int bonusOf(int id) {
        int n = catalogSize();
        int i = id % n; if (i < 0) { i = i + n; }
        int band = (i * 10 / n);             // 0..9 position band
        if (band <= 2) { return i % 4; }     // common: +0..+3
        if (band <= 5) { return 4 + (i % 3); } // fine:   +4..+6
        return 6 + (i % 4);                   // legendary: +6..+9
    }

    // Deeper levels of Moria upgrade a find's bonus — depth 8 can mint +9s.
    int bonusAtDepth(int id, int depth) {
        int b = bonusOf(id);
        int bump = depth / 2;                 // +1 per two levels of descent
        int v = b + bump;
        if (v > 9) { v = 9; }
        return v;
    }

    int dieOf(int id) {
        int f = (id / MATERIALS) % FORMS;
        // Heavier forms, bigger dice.
        if (f == 3 || f == 13 || f == 22 || f == 27) { return 12; } // great weapons
        if (f == 1 || f == 2 || f == 7 || f == 19 || f == 24) { return 10; }
        if (f == 5) { return 4; }             // dagger
        if (f == 0 || f == 12 || f == 14) { return 8; }
        return 8;
    }

    int weightOf(int id) {
        int f = (id / MATERIALS) % FORMS;
        if (f == 3 || f == 22 || f == 27) { return 5; }
        if (f == 5 || f == 23) { return 1; }
        return 3;
    }

    // The dressed-up base name (no bonus suffix).
    String baseName(int id) {
        int n = catalogSize();
        int i = id % n; if (i < 0) { i = i + n; }
        int m = i % MATERIALS;
        int f = (i / MATERIALS) % FORMS;
        int l = (i / (MATERIALS * FORMS)) % LEGENDS;
        return material(m) + " " + form(f) + " of " + legend(l);
    }

    String plusTag(int bonus) {
        if (bonus <= 0) { return ""; }
        return " +" + bonus;
    }

    // Forge the weapon at a catalog index, enchanted for a given depth.
    Weapon forge(int id, int depth) {
        Weapon w = new Weapon();
        w.id = id;
        w.bonus = bonusAtDepth(id, depth);
        w.dieSides = dieOf(id);
        w.weight = weightOf(id);
        w.name = baseName(id) + plusTag(w.bonus);
        return w;
    }

    // Total melee damage of a weapon for a given die roll and Strength modifier.
    // The +N enchantment adds to damage; when MUTUAL_PLUS is on it also added to
    // the to-hit (see toHitBonus), so the plus is "mutual".
    int damage(Weapon w, int dieRoll, int strMod) {
        int d = dieRoll;
        if (d < 1) { d = 1; }
        if (d > w.dieSides) { d = w.dieSides; }
        int total = d + w.bonus + strMod;
        if (total < 1) { total = 1; }
        return total;
    }

    boolean isFinePlus(Weapon w) { return w.bonus >= 4; }   // +4 or greater

    // =======================================================================
    // Ranged arms — crossbows and bows
    // =======================================================================
    // Ranged weapons reach AT LEAST 8 squares, carry a richer enchantment band
    // of +3..+28, and strike for 2d12 + 8 (two twelve-sided dice plus 8) — an
    // average set of 2*6.5 + 8 = 21 damage before the enchantment is added.

    static int RANGED_FORMS = 16;        // bow and crossbow variants
    static int MIN_RANGE    = 8;         // every ranged arm reaches >= 8 squares
    static int RANGED_DICE  = 2;         // 2 dice...
    static int RANGED_SIDES = 12;        // ...of d12...
    static int RANGED_BASE  = 8;         // ...plus 8  => 2d12 + 8
    static int RANGED_BONUS_MIN = 3;     // +3 ...
    static int RANGED_BONUS_MAX = 28;    // ...to +28

    int rangedCatalogSize() { return RANGED_FORMS * MATERIALS * LEGENDS; }

    // The eight-and-more bow and crossbow forms. Crossbows reach a little
    // farther than bows; the exact range is set in rangeOf().
    String rangedForm(int i) {
        int k = i % RANGED_FORMS;
        if (k == 0)  { return "Shortbow"; }
        if (k == 1)  { return "Longbow"; }
        if (k == 2)  { return "Warbow"; }
        if (k == 3)  { return "Recurve Bow"; }
        if (k == 4)  { return "Composite Bow"; }
        if (k == 5)  { return "Elven Greatbow"; }
        if (k == 6)  { return "Horn Bow"; }
        if (k == 7)  { return "Hunter's Bow"; }
        if (k == 8)  { return "Hand Crossbow"; }
        if (k == 9)  { return "Light Crossbow"; }
        if (k == 10) { return "Heavy Crossbow"; }
        if (k == 11) { return "Arbalest"; }
        if (k == 12) { return "Repeating Crossbow"; }
        if (k == 13) { return "Siege Crossbow"; }
        if (k == 14) { return "Dwarf Crossbow"; }
        return "Windlass Crossbow";
    }

    // =======================================================================
    // The MUTUAL plus: +N applies to BOTH to-hit and damage when the setting
    // is on. These expose the two sides of the same bonus.
    // =======================================================================
    boolean mutualPlus() { return MUTUAL_PLUS == 1; }

    int toHitBonus(Weapon w) {
        if (MUTUAL_PLUS == 1) { return w.bonus; }  // mutual: the plus hits too
        return 0;                                   // otherwise: damage only
    }

    int damageBonus(Weapon w) { return w.bonus; }  // the plus always damages

    // =======================================================================
    // The incurrence-radius / depth model for extra damage.
    // =======================================================================

    // radiusBase(bonus) = 2^(bonus + RADIUS_BASE_SHIFT). +5 => 256; +4 => 128;
    // +3 => 64; +2 => 32; +1 => 16; +0 => 8. A clean geometric falloff.
    int radiusBase(int bonus) {
        int b = bonus;
        if (b < 0) { b = 0; }
        if (b > 9) { b = 9; }
        int shift = b + RADIUS_BASE_SHIFT;
        int v = 1;
        int i = 0;
        while (i < shift) { v = v * 2; i = i + 1; }   // 2^shift (no bit-ops)
        return v;
    }

    // Depth generosity: the reference depth is x1; LOWER depths are MORE
    // generous (bigger rolls). depthMultiplier = REF_DEPTH / depth, clamped so
    // it is never less than 1 (deeper than the reference is not stingier than
    // the reference — it simply stops gaining generosity).
    int depthMultiplier(int depth) {
        int dp = depth;
        if (dp < 1) { dp = 1; }
        int m = RADIUS_REF_DEPTH / dp;
        if (m < 1) { m = 1; }
        return m;
    }

    // The incurrence radius LEVELS for a +N weapon at a given depth.
    // ANCHOR: radiusLevels(5, 16) = 256.
    int radiusLevels(int bonus, int depth) {
        return radiusBase(bonus) * depthMultiplier(depth);
    }

    // The extra POTENTIAL damage carried by that radius.
    // ANCHOR: extraPotential(5, 16) = 256 * 4 = 1024.
    int extraPotential(int bonus, int depth) {
        return radiusLevels(bonus, depth) * EXTRA_PER_RADIUS;
    }

    // The ACTUAL extra damage incurred on a strike: a seeded roll in
    // [0 .. extraPotential], drawn by the caller's deterministic stream. The
    // mean incurrence is about half the potential, so a +5 at depth 16 averages
    // ~512 extra and may spike to the full ~1024.
    int extraDamageRoll(Weapon w, int depth, int rollValue) {
        int cap = extraPotential(w.bonus, depth);
        if (cap <= 0) { return 0; }
        int r = rollValue;
        if (r < 0) { r = 0 - r; }
        return r % (cap + 1);          // 0 .. extraPotential inclusive
    }

    // =======================================================================
    // The Mace — the signature weapon. Average 1d48 + 26 hit points.
    // =======================================================================
    Weapon mace(int bonus, int depth) {
        Weapon w = new Weapon();
        w.id = 4;                        // the Mace form index in the forge
        w.dieSides = MACE_DIE;           // 1d48
        w.bonus = bonus;
        w.weight = 3;
        w.name = "Mace of the Deep" + plusTag(bonus);
        return w;
    }

    // The Mace's base strike (before the enchantment radius): 1d48 + 26 + STR,
    // plus the mutual damage bonus.
    int maceDamage(Weapon w, int dieRoll, int strMod) {
        int d = dieRoll;
        if (d < 1) { d = 1; }
        if (d > MACE_DIE) { d = MACE_DIE; }
        int total = d + MACE_FLAT + damageBonus(w) + strMod;
        if (total < 1) { total = 1; }
        return total;
    }

    // The Mace's average base damage, for the sheet (1d48 avg 24.5 + 26 ~ 50).
    int maceAverage() { return (1 + MACE_DIE) / 2 + MACE_FLAT; }

    String maceFormula() {
        return "1d" + MACE_DIE + " + " + MACE_FLAT
             + " (avg ~" + maceAverage() + ")";
    }

    // Is this ranged form a crossbow (vs. a bow)? Forms 8..15 are crossbows.
    boolean rangedIsCrossbow(int i) { return (i % RANGED_FORMS) >= 8; }

    // Range in squares, always >= 8. Bows 8..15, crossbows 10..17 (crossbows
    // carry farther), derived from the form so a given index is stable.
    int rangeOf(int id) {
        int f = id % RANGED_FORMS;
        if (rangedIsCrossbow(f)) { return MIN_RANGE + 2 + (f - 8); }  // 10..17
        return MIN_RANGE + f;                                          // 8..15
    }

    // The ranged enchantment +N, spread across +3..+28. Deterministic per index
    // and biased so the catalog spans the whole band.
    int rangedBonusOf(int id) {
        int n = rangedCatalogSize();
        int i = id % n; if (i < 0) { i = i + n; }
        int span = RANGED_BONUS_MAX - RANGED_BONUS_MIN + 1;   // 26 steps (3..28)
        return RANGED_BONUS_MIN + (i % span);
    }

    // Deeper levels of Moria upgrade a ranged find's bonus, capped at +28.
    int rangedBonusAtDepth(int id, int depth) {
        int b = rangedBonusOf(id);
        int v = b + depth;                 // +1 per level descended
        if (v > RANGED_BONUS_MAX) { v = RANGED_BONUS_MAX; }
        if (v < RANGED_BONUS_MIN) { v = RANGED_BONUS_MIN; }
        return v;
    }

    // The dressed-up ranged name (material + bow/crossbow form + legend).
    String rangedBaseName(int id) {
        int n = rangedCatalogSize();
        int i = id % n; if (i < 0) { i = i + n; }
        int m = i % MATERIALS;
        int f = (i / MATERIALS) % RANGED_FORMS;
        int l = (i / (MATERIALS * RANGED_FORMS)) % LEGENDS;
        return material(m) + " " + rangedForm(f) + " of " + legend(l);
    }

    // Forge a crossbow or bow at a catalog index, enchanted for a given depth.
    // Every one reaches >= 8 squares and strikes for 2d12 + 8 (+ the bonus).
    Weapon forgeRanged(int id, int depth) {
        Weapon w = new Weapon();
        w.id = id;
        w.ranged = true;
        w.range = rangeOf(id);
        w.dieSides = RANGED_SIDES;     // d12
        w.diceCount = RANGED_DICE;     // 2 of them
        w.baseAdd = RANGED_BASE;       // + 8
        w.bonus = rangedBonusAtDepth(id, depth);
        w.weight = 3;
        if (rangedIsCrossbow(id)) { w.weight = 4; }
        w.name = rangedBaseName(id) + plusTag(w.bonus);
        return w;
    }

    // Ranged damage: sum of `diceCount` d`dieSides` rolls + baseAdd + bonus.
    // Pass the two d12 rolls (roll1, roll2) from the caller's dice stream; for
    // 2d12 only the first two are used. The average set is 2d12+8 = 21 (+bonus).
    int rangedDamage(Weapon w, int roll1, int roll2, int bonusMod) {
        if (!w.ranged) { return damage(w, roll1, bonusMod); }
        int r1 = clampDie(roll1, w.dieSides);
        int r2 = clampDie(roll2, w.dieSides);
        int total = r1 + r2 + w.baseAdd + w.bonus + bonusMod;
        if (total < 1) { total = 1; }
        return total;
    }

    int clampDie(int r, int sides) {
        if (r < 1) { return 1; }
        if (r > sides) { return sides; }
        return r;
    }

    // The AVERAGE damage of a ranged weapon's set: 2d12 avg (2 * 6.5 = 13) + 8,
    // plus the enchantment. Rounds the die average down (integer math): a d12
    // averages 6 here, so 2d12 -> 12, + 8 = 20, + bonus.
    int rangedAverage(Weapon w) {
        if (!w.ranged) { return (w.dieSides / 2) + w.bonus; }
        int avgDie = w.dieSides / 2;                 // 6 for d12
        return w.diceCount * avgDie + w.baseAdd + w.bonus;
    }

    // Can this weapon strike a target `squares` away?
    boolean canReach(Weapon w, int squares) {
        if (w.ranged) { return squares <= w.range; }
        return squares <= 1;   // melee: adjacent only
    }

    boolean isRanged(Weapon w) { return w.ranged; }
    boolean isCrossbow(Weapon w) { return w.ranged && w.weight >= 4; }

    String serialize(Weapon w) {
        return "WEAPON|id=" + w.id + "|die=" + w.dieSides
             + "|bonus=" + w.bonus + "|weight=" + w.weight
             + "|ranged=" + boolTag(w.ranged) + "|range=" + w.range
             + "|dice=" + w.diceCount + "|base=" + w.baseAdd;
    }

    String boolTag(boolean b) { if (b) { return "1"; } return "0"; }

    String describe(Weapon w) {
        if (w.ranged) {
            String kind = "bow";
            if (isCrossbow(w)) { kind = "crossbow"; }
            // e.g. "2d12+8 +17" with a range in squares and the average set.
            return "#" + w.id + "  " + w.name
                 + "  (" + kind + ", range " + w.range + " sq, "
                 + w.diceCount + "d" + w.dieSides + "+" + w.baseAdd
                 + " +" + w.bonus + ", avg " + rangedAverage(w) + ")";
        }
        String fine = "";
        if (isFinePlus(w)) { fine = "  <<+4 or greater>>"; }
        return "#" + w.id + "  " + w.name
             + "  (d" + w.dieSides + " +" + w.bonus + ", wt " + w.weight + ")" + fine;
    }

    void main() {
        print("Moria — The Armoury");
        print("Name-forge catalog: " + catalogSize() + " distinct weapons.");
        print("Many are +4 or greater; the deep levels mint the legendary.");
        print("");
        print("A few forged arms (depth 6):");
        int i = 0;
        int finePlus = 0;
        while (i < 10) {
            int id = i * 1337 + 11;      // scatter across the catalog
            Weapon w = forge(id, 6);
            if (isFinePlus(w)) { finePlus = finePlus + 1; }
            print("  " + describe(w));
            i = i + 1;
        }
        print("");
        print(finePlus + " of those 10 were +4 or greater.");

        print("");
        print("Ranged arms — crossbows and bows");
        print("  range >= " + MIN_RANGE + " squares, +" + RANGED_BONUS_MIN
            + " to +" + RANGED_BONUS_MAX + ", " + RANGED_DICE + "d"
            + RANGED_SIDES + "+" + RANGED_BASE + " (average set).");
        print("  Ranged catalog: " + rangedCatalogSize() + " distinct bows + crossbows.");
        print("");
        int j = 0;
        while (j < 10) {
            int id = j * 911 + 5;        // scatter across the ranged catalog
            Weapon b = forgeRanged(id, 6);
            print("  " + describe(b));
            j = j + 1;
        }
        print("");
        // A sample volley at range: two d12s + 8 + the enchantment.
        Weapon shot = forgeRanged(10, 8);     // a crossbow, deep-forged
        print("Sample shot: " + shot.name);
        print("  reaches " + shot.range + " squares; a target 8 away is "
            + reachWord(canReach(shot, 8)) + ".");
        print("  volley (12 + 11 on the dice): "
            + rangedDamage(shot, 12, 11, 0) + " damage.");
        print("  average set: " + rangedAverage(shot) + " ("
            + RANGED_DICE + "d" + RANGED_SIDES + "+" + RANGED_BASE
            + " +" + shot.bonus + ").");

        // --- The Mace + the incurrence-radius / depth model ---------------
        print("");
        print("The Mace of the Deep: " + maceFormula()
            + "   (mutual plus: " + yn(mutualPlus()) + ")");
        Weapon m5 = mace(5, 16);
        print("  a +5 Mace strike (die 30, STR+3): base "
            + maceDamage(m5, 30, 3)
            + "  + enchant radius extra up to " + extraPotential(5, 16));

        print("");
        print("Incurrence radius by enchantment (at Dungeon Depth 16):");
        int bb = 0;
        while (bb <= 5) {
            print("  +" + bb + "  radius=" + radiusLevels(bb, 16)
                + " levels  -> up to " + extraPotential(bb, 16)
                + " extra potential damage");
            bb = bb + 1;
        }

        print("");
        print("Depth generosity for a +5 weapon (lower depths roll bigger):");
        print("  depth 16  radius=" + radiusLevels(5, 16)
            + "  extra up to " + extraPotential(5, 16));
        print("  depth  8  radius=" + radiusLevels(5, 8)
            + "  extra up to " + extraPotential(5, 8));
        print("  depth  4  radius=" + radiusLevels(5, 4)
            + "  extra up to " + extraPotential(5, 4));
        print("  depth  1  radius=" + radiusLevels(5, 1)
            + "  extra up to " + extraPotential(5, 1));
    }

    String reachWord(boolean ok) { if (ok) { return "in range"; } return "out of range"; }

    String yn(boolean b) { if (b) { return "yes"; } return "no"; }
}
