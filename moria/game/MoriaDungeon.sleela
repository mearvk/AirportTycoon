#sleela 1.6
//
// Moria — the Dungeon Crawler core
// ================================
// A small, deterministic Moria dungeon crawler, in simple new video-game
// theatrics: a hero descends the Mines of Moria one level at a time, moving by
// torchlight through rough-hewn rooms, past the orc and the troll, toward the
// stair down — and, far below, the Balrog on level eight.
//
// This Wrapper is a SINGLE #sleela 1.6 class (the game-Wrapper convention used
// by game/AirportTycoon.sleela). Like that Wrapper, the 1.6 game dialect
// provides scalars, `struct` reference types and `new StructName()` — NOT
// arrays — so the dungeon is kept array-free:
//
//   * the MAP is computed PROCEDURALLY from (seed, depth, x, y): the same seed
//     and depth always yield the same walls, stair, treasure and monsters, so
//     nothing needs to be stored in a grid;
//   * MUTATIONS (a slain monster, gathered treasure) are recorded as a small
//     singly-linked list of `Change` struct nodes layered over the procedural
//     base — exactly the intrusive-list pattern the airport Wrapper uses;
//   * the CHRONICLE is a singly-linked list of `Msg` struct nodes.
//
// The GUI front-end (ui-sleela/MoriaUI.sleela) presents this same model in a
// SleelaUI text pane; the headless renderGrid()/recentLog() here are the
// authoritative read, so the game is fully playable with no display at all.
//
// Determinism: every "roll" comes from a seeded linear-congruential stream, so
// a given seed replays the same descent, step for step — the Careful Years of
// Time repeat exactly.
//
// Theatrics (the glyph alphabet the text pane paints):
//   @  the Adventurer        #  rough wall           .  lit floor
//   ' '(space) unseen dark   >  the stair down        $  a glint of treasure
//   o  an orc                T  a troll               B  the Balrog
//   +  a door

// A chronicle line (intrusive singly-linked list node).
struct Msg {
    String text;
    Msg    next;
}

// A cell mutation layered over the procedural base: at (x,y) on this depth, the
// cell has been changed to `glyph` (usually floor, after a kill or pickup).
struct Change {
    int    depth;
    int    x;
    int    y;
    String glyph;
    Change next;
}

// A FIGURING PIECE — one of the Original Characters of the tale, rendered as a
// movable figure (a token) that wanders the UI's dungeon pane. Each piece has a
// stable glyph, a short name, a role, a live position, and a deterministic
// per-turn drift. Pieces are held in an intrusive singly-linked list, exactly
// like Change and Msg, so the model stays array-free (SLeeLa 1.6).
struct Figure {
    String name;    // "Gandalf", "Frodo", ...
    String glyph;   // the one-character token painted on the pane
    String role;    // "Companion of the Fellowship" / "Foe of the Deep"
    int    x;
    int    y;
    boolean friendly; // true for the Fellowship, false for a named foe
    boolean active;   // on the current depth and in play
    Figure next;
}

class MoriaDungeon {

    // ---- Map dimensions (a comfortable torch-lit chamber) -----------------
    static int W = 40;        // columns
    static int H = 18;        // rows

    // ---- Glyphs (one-character strings; the pane colours them by role) -----
    static String G_HERO     = "@";
    static String G_WALL     = "#";
    static String G_FLOOR    = ".";
    static String G_DARK     = " ";
    static String G_STAIR    = ">";
    static String G_TREASURE = "$";
    static String G_ORC      = "o";
    static String G_TROLL    = "T";
    static String G_BALROG   = "B";
    static String G_DOOR     = "+";

    // ---- Figuring-piece glyphs: the Original Characters of the tale --------
    // Each is a distinct token the pane paints as a wandering figure. Chosen so
    // none collides with a terrain/monster glyph above.
    static String G_GANDALF  = "G";   // Gandalf the Grey — the guide
    static String G_FRODO    = "F";   // Frodo — the ring-bearer
    static String G_ARAGORN  = "A";   // Aragorn — the ranger
    static String G_LEGOLAS  = "L";   // Legolas — the elf
    static String G_GIMLI    = "D";   // Gimli — the dwarf (D, so as not to clash)
    static String G_SAURON   = "S";   // the Eye's reach — a named foe that stalks

    // ---- Deterministic RNG (seeded MINSTD) --------------------------------
    static int RNG_MOD  = 2147483647;
    static int RNG_MULT = 48271;
    int rng;                 // live generator state (advances with play)
    int worldSeed;           // the base seed (used to derive each level)

    // ---- The hero ---------------------------------------------------------
    String heroName;
    int heroX;
    int heroY;
    int depth;               // current dungeon level (1..8)
    int health;              // 0..maxHealth
    int maxHealth;
    int torch;               // torchlight radius, in cells
    int gold;
    int monstersSlain;
    boolean alive;
    boolean descended;       // crossed all eight levels and survived

    // ---- RPG layer: stats, level, the Fireball, the saved book ------------
    MoriaStats   statLib;    // the stat library (modifiers + Character-Number)
    StatBlock    stats;      // the hero's six ability scores (incl. Constitution)
    MoriaSpells  spellLib;   // the spellbook (names thousands; owns the Fireball)
    MoriaWeapons armoury;    // the armoury (names thousands; many +4 or greater)
    MoriaSave    book;       // Save / Load / Alter + the leveling ledger
    MoriaBestiary bestiary;  // the roster of named legends, keyed to depth
    MoriaGrimoire grimoire;  // usable castings by class + lich pacts + the duo
    MoriaCreator  creator;   // the character-creation generator (base + feats)
    int          heroClass;  // CLS_* — Fighter/Mage/Cleric/Wizard
    int          heroStanding;// civic standing from lifetime feats (the snuff)
    int          heroFeats;  // bitmask of lifetime feats the hero holds
    Creature0    pendingChar;// a created character to adopt on begin (or null)
    int          level;      // the Adventurer's experience level (grows on descent)
    Weapon       weapon;     // the hero's current melee weapon (forged on descent)
    Weapon       sidearm;    // the hero's ranged arm — a crossbow or bow (>= 8 sq)
    Weapon       mace;       // the signature Mace of the Deep (1d48 + 26)
    Legend       lord;       // the named legend who holds the current depth
    Pact         pact;       // a lich obedience pact in flight (null if none)

    // ---- Per-level derived geometry (computed in carveLevel) --------------
    int stairX;
    int stairY;

    // ---- Mutations layered over the procedural base -----------------------
    Change changes;          // head of the change list (newest first)

    // ---- The figuring pieces: Original Characters that roam the UI ---------
    Figure figures;          // head of the figure list
    int    figureCount;      // how many pieces are on the board

    // ---- The scrollback chronicle -----------------------------------------
    Msg  logHead;            // oldest
    Msg  logTail;            // newest
    int  logCount;
    int  turns;

    // =======================================================================
    // Lifecycle
    // =======================================================================

    // Start a descent with a character made by the creation generator: adopt
    // its stats, gold, standing, and lifetime feats. Pass the Creature0 and a
    // world seed.
    void beginFromCharacter(Creature0 ch, int seed) {
        pendingChar = ch;
        begin(ch.name, seed);
        pendingChar = null;          // consumed
    }

    void begin(String name, int seed) {
        heroName = name;
        if (heroName == null) { heroName = "Adventurer"; }
        worldSeed = normalizeSeed(seed);
        rng = worldSeed;
        changes = null;
        logHead = null;
        logTail = null;
        logCount = 0;
        turns = 0;
        depth = 1;
        torch = 6;
        gold = 0;
        monstersSlain = 0;
        alive = true;
        descended = false;
        figures = null;
        figureCount = 0;

        // --- RPG layer: roll the six stats, set the level, forge a weapon ---
        statLib = new MoriaStats();
        spellLib = new MoriaSpells();
        armoury = new MoriaWeapons();
        book = new MoriaSave();
        book.begin();
        bestiary = new MoriaBestiary();
        bestiary.begin();
        grimoire = new MoriaGrimoire();
        creator = new MoriaCreator();
        creator.begin();
        heroClass = grimoire.CLS_WIZARD;   // a Wizard by default (full caster)
        heroStanding = 0;
        heroFeats = 0;
        pact = null;
        level = 1;
        // Ability scores: adopt a character made by the creation generator if
        // one was supplied (beginFromCharacter), else roll fresh from the
        // seeded stream. A created character also brings its starting gold,
        // civic standing, and lifetime feats (the "snuff").
        if (pendingChar != null) {
            stats = creator.statBlock(pendingChar);
            heroName = pendingChar.name;
            gold = pendingChar.gold;
            heroStanding = pendingChar.standing;
            heroFeats = pendingChar.feats;
        } else {
            stats = statLib.fromSeeded(nextRng(), nextRng(), nextRng(),
                                       nextRng(), nextRng(), nextRng());
        }
        // Hit points come from Constitution: a base plus CON per level.
        maxHealth = 24 + statLib.hpPerLevel(stats);
        health = maxHealth;
        // A starting weapon, forged for depth 1.
        weapon = armoury.forge(nextRng() % armoury.catalogSize(), 1);
        // A starting ranged arm — a crossbow or bow (reaches >= 8 squares,
        // +3..+28, strikes for 2d12 + 8), forged for depth 1.
        sidearm = armoury.forgeRanged(nextRng() % armoury.rangedCatalogSize(), 1);
        // The signature Mace of the Deep: 1d48 + 26, enchanted +5. The hero
        // takes it up as his main melee arm (its mutual plus and incurrence
        // radius make it far mightier than a scavenged blade).
        mace = armoury.mace(5, 1);
        weapon = mace;
        // Record the first level in the saved leveling ledger.
        book.recordLevel(1, maxHealth, 0, "Entered the Mines of Moria.");

        carveLevel();
        musterFellowship();
        say("You step into the Mines of Moria. The dark is patient.");
        say("Depth 1. Your torch throws a small, brave circle of light.");
        say(heroName + ": " + statLib.describe(stats));
        say(statLib.lifeRead(stats));
        say("You carry the " + weapon.name + " — " + armoury.maceFormula()
            + ", enchanted +" + weapon.bonus + " (mutual to hit and damage).");
        say("At depth " + depth + " its radius can incur up to "
            + armoury.extraPotential(weapon.bonus, depth) + " extra damage.");
        say("You sling the " + sidearm.name + " (range " + sidearm.range
            + " sq, 2d12+8 +" + sidearm.bonus + ").");
        say("You know the Fireball: " + spellLib.fireballFormula() + ".");
        say("You are a " + grimoire.className(heroClass) + ", knowing "
            + grimoire.spellsForClass(heroClass) + " castings of the Grimoire.");
        if (heroFeats != 0) {
            say("Lifetime feats carried into the Mines: " + heroFeatList()
                + "  (standing " + heroStanding + ", purse " + gold + ").");
        }
        say("The Fellowship musters: Gandalf, Frodo, Aragorn, Legolas, Gimli.");
        summonLord();
    }

    // The named legend who holds the current depth. Deeper halls answer to
    // mightier legends; shallow halls to mere mortals of renown.
    void summonLord() {
        int li = bestiary.lordOfDepth(depth);
        if (li < 0) { lord = null; return; }
        lord = bestiary.materialize(li, depth);
        say("A presence holds depth " + depth + ": " + lord.name
            + " — " + lord.title + " (CR " + lord.cr + ").");
    }

    int normalizeSeed(int s) {
        int v = s;
        if (v < 0) { v = 0 - v; }
        v = v % RNG_MOD;
        if (v == 0) { v = 1; }
        return v;
    }

    int nextRng() {
        rng = (RNG_MULT * rng) % RNG_MOD;
        if (rng <= 0) { rng = rng + RNG_MOD; }
        return rng;
    }

    int roll(int lo, int hi) {
        if (hi <= lo) { return lo; }
        return lo + (nextRng() % (hi - lo + 1));
    }

    // A stable per-level hash (no live state), used by the procedural map so a
    // cell's base glyph depends only on (worldSeed, depth, x, y).
    int hash(int a, int b, int c, int d) {
        int h = normalizeSeed(worldSeed);
        h = (h * 31 + a) % RNG_MOD; if (h < 0) { h = h + RNG_MOD; }
        h = (h * 31 + b) % RNG_MOD; if (h < 0) { h = h + RNG_MOD; }
        h = (h * 31 + c) % RNG_MOD; if (h < 0) { h = h + RNG_MOD; }
        h = (h * 31 + d) % RNG_MOD; if (h < 0) { h = h + RNG_MOD; }
        return h;
    }

    // =======================================================================
    // Level setup: pick the stair and hero start; the rest is procedural.
    // =======================================================================

    void carveLevel() {
        // Hero near the left, on the mid-line.
        heroX = 2;
        heroY = H / 2;
        // Stair near the right wall; its row is derived from the level hash so
        // it is stable for a given seed+depth.
        stairX = W - 3;
        stairY = 2 + (hash(depth, 7, 7, 7) % (H - 4));
        // Clear any lingering change list from the previous level by filtering
        // on depth at read time (we simply keep appending; reads check depth).
    }

    // =======================================================================
    // Procedural base glyph at (x,y) for the CURRENT depth, before mutations.
    // =======================================================================

    String baseGlyph(int x, int y) {
        // Border walls.
        if (x == 0 || y == 0 || x == W - 1 || y == H - 1) { return G_WALL; }
        // The stair down.
        if (x == stairX && y == stairY) { return G_STAIR; }
        // A single door on the top mid-line (theatrics).
        if (y == 1 && x == W / 2) { return G_DOOR; }

        // Interior pillars: a sparse, deterministic scatter.
        if (x > 2 && x < W - 2 && y > 1 && y < H - 1) {
            if ((hash(depth, x, y, 1) % 23) == 0) { return G_WALL; }
        }

        // The Balrog guards the deep, just before the stair on level 8.
        if (depth >= 8 && x == stairX - 2 && y == stairY) { return G_BALROG; }

        // Monsters and treasure live in the right two-thirds of the hall.
        if (x >= W / 3 && x < W - 2 && y > 1 && y < H - 1) {
            int r = hash(depth, x, y, 2) % 100;
            // Orc density grows with depth.
            if (r < 4 + depth) { return G_ORC; }
            // A troll appears from depth 3 (rarer).
            if (depth >= 3 && r >= 40 && r < 42) { return G_TROLL; }
            // Treasure glints (uncommon).
            if (r >= 60 && r < 63) { return G_TREASURE; }
        }
        return G_FLOOR;
    }

    // =======================================================================
    // Mutations: look up / record an overriding glyph at (depth,x,y).
    // =======================================================================

    String changeAt(int x, int y) {
        Change c = changes;
        while (c != null) {
            if (c.depth == depth && c.x == x && c.y == y) { return c.glyph; }
            c = c.next;
        }
        return null;
    }

    void setChange(int x, int y, String glyph) {
        Change c = new Change();
        c.depth = depth;
        c.x = x;
        c.y = y;
        c.glyph = glyph;
        c.next = changes;   // newest first; changeAt returns the newest match
        changes = c;
    }

    // The effective glyph at a cell: a mutation if present, else the base.
    String cell(int x, int y) {
        if (!inBounds(x, y)) { return G_WALL; }
        String m = changeAt(x, y);
        if (m != null) { return m; }
        return baseGlyph(x, y);
    }

    // =======================================================================
    // The figuring pieces: the Original Characters that move around the UI.
    // =======================================================================

    // Add one figure at a deterministic open cell derived from (seed, depth,
    // slot). Pieces never spawn on a wall, the stair, or the hero's start.
    void addFigure(String name, String glyph, String role, boolean friendly, int slot) {
        Figure f = new Figure();
        f.name = name;
        f.glyph = glyph;
        f.role = role;
        f.friendly = friendly;
        f.active = true;
        // Seek a deterministic open cell for this piece on this depth.
        int tries = 0;
        int fx = 3;
        int fy = 2;
        while (tries < 64) {
            int hx = 2 + (hash(depth, slot, tries, 11) % (W - 4));
            int hy = 1 + (hash(depth, slot, tries, 22) % (H - 2));
            if (isOpenForFigure(hx, hy)) { fx = hx; fy = hy; tries = 64; }
            else { tries = tries + 1; }
        }
        f.x = fx;
        f.y = fy;
        f.next = figures;
        figures = f;
        figureCount = figureCount + 1;
    }

    // Muster the Fellowship (and the one named foe that stalks the deep). This
    // is the "one-off figuring pieces" roster of Original Characters.
    void musterFellowship() {
        addFigure("Gandalf", G_GANDALF, "Companion — the Guide",     true, 1);
        addFigure("Frodo",   G_FRODO,   "Companion — the Bearer",    true, 2);
        addFigure("Aragorn", G_ARAGORN, "Companion — the Ranger",    true, 3);
        addFigure("Legolas", G_LEGOLAS, "Companion — the Elf",       true, 4);
        addFigure("Gimli",   G_GIMLI,   "Companion — the Dwarf",     true, 5);
        // The Eye's reach appears from the middle depths onward.
        if (depth >= 4) {
            addFigure("Sauron's Eye", G_SAURON, "Foe — the Stalker", false, 6);
        }
    }

    // A cell a figure may stand on: in bounds, not a wall, not the stair, not a
    // base monster/treasure, and not already holding another figure.
    boolean isOpenForFigure(int x, int y) {
        if (!inBounds(x, y)) { return false; }
        if (x == heroX && y == heroY) { return false; }
        String g = cell(x, y);
        if (g == G_WALL) { return false; }
        if (g == G_STAIR) { return false; }
        if (g == G_DOOR) { return false; }
        if (g == G_ORC || g == G_TROLL || g == G_BALROG) { return false; }
        if (g == G_TREASURE) { return false; }
        if (figureAt(x, y) != null) { return false; }
        return true;
    }

    // The figure occupying (x,y) on the current board, or null.
    Figure figureAt(int x, int y) {
        Figure f = figures;
        while (f != null) {
            if (f.active && f.x == x && f.y == y) { return f; }
            f = f.next;
        }
        return null;
    }

    // Re-muster the roster for a new depth: every piece seeks a fresh open cell
    // so the Original Characters follow the hero down the Mines.
    void remusterForDepth() {
        Figure f = figures;
        int slot = 0;
        while (f != null) {
            slot = slot + 1;
            // The stalker only haunts the deeper halls.
            if (!f.friendly && depth < 4) { f.active = false; }
            else { f.active = true; relocateFigure(f, slot); }
            f = f.next;
        }
    }

    // Move one figure to a deterministic open cell on the current depth.
    void relocateFigure(Figure f, int slot) {
        int tries = 0;
        while (tries < 64) {
            int hx = 2 + (hash(depth, slot, tries, 33) % (W - 4));
            int hy = 1 + (hash(depth, slot, tries, 44) % (H - 2));
            if (isOpenForFigure(hx, hy)) { f.x = hx; f.y = hy; tries = 64; }
            else { tries = tries + 1; }
        }
    }

    // Advance every figure one deterministic step. Companions drift gently
    // toward the hero (they keep formation); the stalker drifts toward him with
    // intent. A blocked step is simply skipped — pieces never overlap or clip
    // through walls, which keeps the board readable and in-bounds.
    void stepFigures() {
        Figure f = figures;
        while (f != null) {
            if (f.active) { driftFigure(f); }
            f = f.next;
        }
    }

    void driftFigure(Figure f) {
        // Preferred direction: toward the hero (sign of the delta), with a
        // small seeded wobble so the formation looks alive but stays stable.
        int wob = hash(turns, f.x, f.y, 55) % 3;   // 0,1,2
        int dx = signTowardWithWobble(heroX - f.x, wob);
        int dy = signTowardWithWobble(heroY - f.y, wob);
        // Try the diagonal first, then each axis, then stand still.
        if (tryFigureStep(f, dx, dy)) { return; }
        if (tryFigureStep(f, dx, 0))  { return; }
        if (tryFigureStep(f, 0, dy))  { return; }
        // otherwise the piece holds its ground this turn.
    }

    // Move toward a target along one axis: -1, 0, or +1, nudged by a wobble so
    // the pieces do not march in a dead-straight line.
    int signTowardWithWobble(int delta, int wob) {
        int s = 0;
        if (delta > 0) { s = 1; }
        else if (delta < 0) { s = 0 - 1; }
        if (wob == 2) { s = 0 - s; }   // occasional backstep: the figure meanders
        return s;
    }

    boolean tryFigureStep(Figure f, int dx, int dy) {
        if (dx == 0 && dy == 0) { return false; }
        int nx = f.x + dx;
        int ny = f.y + dy;
        if (!isOpenForFigure(nx, ny)) { return false; }
        f.x = nx;
        f.y = ny;
        return true;
    }

    // The figure glyph to paint at (x,y), or null if no active figure is there.
    String figureGlyphAt(int x, int y) {
        Figure f = figureAt(x, y);
        if (f == null) { return null; }
        return f.glyph;
    }

    boolean inBounds(int x, int y) { return x >= 0 && y >= 0 && x < W && y < H; }
    boolean isWall(int x, int y)  { return cell(x, y) == G_WALL; }

    // =======================================================================
    // The turn: the hero moves one step (dx,dy in -1..1)
    // =======================================================================

    boolean move(int dx, int dy) {
        if (!alive) { return false; }
        // A lich's obedience pact PAUSES the character: while obeying an
        // unresolved pact, you cannot act until the Spelling Duo is answered.
        if (characterPaused()) {
            say("You are bound to Obey. The pact holds you — answer the Spelling "
                + "Duo to be freed.");
            return false;
        }
        int nx = heroX + dx;
        int ny = heroY + dy;
        if (!inBounds(nx, ny) || isWall(nx, ny)) {
            say("A wall of ancient dwarf-stone. You cannot pass.");
            return false;
        }
        turns = turns + 1;
        String there = cell(nx, ny);

        if (there == G_ORC)    { return fight(nx, ny, "orc", 6); }
        if (there == G_TROLL)  { return fight(nx, ny, "troll", 12); }
        if (there == G_BALROG) { return fightBalrog(nx, ny); }

        if (there == G_TREASURE) {
            int found = roll(10, 60);
            gold = gold + found;
            say("Gold glints in the rubble — you gather " + found + " coins.");
            setChange(nx, ny, G_FLOOR);
        }

        if (there == G_STAIR) {
            stepHeroTo(nx, ny);
            descend();
            return true;
        }

        stepHeroTo(nx, ny);
        stepFigures();            // the Original Characters move around the UI
        if (roll(1, 100) <= 6) {
            say("Your torch gutters. The shadows lean closer.");
        }
        return true;
    }

    void stepHeroTo(int nx, int ny) {
        heroX = nx;
        heroY = ny;
    }

    // =======================================================================
    // Combat (deterministic rolls)
    // =======================================================================

    boolean fight(int x, int y, String kind, int threat) {
        // To-hit uses Dexterity PLUS the weapon's mutual enchantment bonus
        // (the "+N to hit or damage is mutual" setting).
        int hit = roll(1, 20) + statLib.dexMod(stats)
                + armoury.toHitBonus(weapon);
        if (hit >= 8) {
            int wdmg = armoury.damage(weapon, roll(1, weapon.dieSides),
                                      statLib.strMod(stats));
            // The enchantment's incurrence radius adds extra potential damage,
            // scaled by the +N and the depth (lower depths roll bigger).
            int extra = armoury.extraDamageRoll(weapon, depth, nextRng());
            int wtotal = wdmg + extra;
            say("You strike the " + kind + " with the " + weapon.name
                + " for " + wdmg + " + " + extra + " radius = " + wtotal
                + " — it falls into the dust.");
            setChange(x, y, G_FLOOR);
            stepHeroTo(x, y);
            monstersSlain = monstersSlain + 1;
            return true;
        }
        int dmg = roll(1, threat);
        health = health - dmg;
        say("The " + kind + " lands a blow for " + dmg + ". (" + health + " HP)");
        if (health <= 0) { die("the " + kind); }
        return false;
    }

    // Loose a bolt or arrow at a monster `squares` away with the ranged sidearm
    // (a crossbow or bow). It reaches only if the target is within the arm's
    // range (>= 8 squares). Damage is 2d12 + 8 + the enchantment, +DEX to hit.
    boolean fireAt(int x, int y, String kind, int squares) {
        if (!armoury.canReach(sidearm, squares)) {
            say("The " + kind + " is " + squares + " squares off — beyond the "
                + sidearm.name + "'s reach of " + sidearm.range + ".");
            return false;
        }
        int hit = roll(1, 20) + statLib.dexMod(stats);
        if (hit >= 8) {
            // Two d12 rolls from the deterministic stream, + 8, + the bonus.
            int shot = armoury.rangedDamage(sidearm, roll(1, 12), roll(1, 12),
                                            statLib.dexMod(stats));
            say("You loose from " + squares + " squares with the " + sidearm.name
                + " for " + shot + " — the " + kind + " drops where it stood.");
            setChange(x, y, G_FLOOR);
            monstersSlain = monstersSlain + 1;
            return true;
        }
        say("Your shot from the " + sidearm.name + " flies wide of the " + kind + ".");
        return false;
    }

    // =======================================================================
    // The Fireball — the signature spell. Damage = 1d28 + 6 per level (+INT).
    // Returns the damage dealt; a target monster at (x,y) is cleared if slain.
    // =======================================================================
    int castFireball(int x, int y) {
        if (!alive) { return 0; }
        int die = roll(1, spellLib.FIREBALL_DIE);        // 1d28
        int base = spellLib.fireballDamage(die, level, statLib.spellPower(stats));
        // Past caster level 6, Fireball ASSUMES Trick, adding a steady +42 HP.
        int dmg = grimoire.fireballWithTrick(base, level);
        if (grimoire.fireballAssumesTrick(level)) {
            say("You cast FIREBALL (assuming Trick past level 6, +"
                + grimoire.FIREBALL_TRICK_BONUS + ") — " + base + " + "
                + grimoire.FIREBALL_TRICK_BONUS + " = " + dmg + " damage.");
        } else {
            say("You cast FIREBALL (" + spellLib.fireballFormula()
                + ") — a roaring bloom of flame for " + dmg + " damage.");
        }
        String there = cell(x, y);
        if (there == G_ORC || there == G_TROLL || there == G_BALROG) {
            setChange(x, y, G_FLOOR);
            monstersSlain = monstersSlain + 1;
            say("The flame takes the " + there + ". It is unmade.");
        }
        return dmg;
    }

    // =======================================================================
    // Magic Missile, then Trick — in that fixed order (MM first, Trick after).
    // Trick adds 1d6 + 6 + 28 HP per caster level ON TOP of the missile.
    // Returns the total wound count dealt to a target at (x,y).
    // =======================================================================
    int castMissileThenTrick(int x, int y) {
        if (!alive) { return 0; }
        int mm = grimoire.magicMissile(roll(1, grimoire.MM_DIE),
                                       roll(1, grimoire.MM_DIE),
                                       roll(1, grimoire.MM_DIE));
        int tr = grimoire.trickAmount(roll(1, grimoire.TRICK_DIE), level);
        int total = mm + tr;        // Magic Missile FIRST, then Trick
        say("You loose MAGIC MISSILE for " + mm + ", then the TRICK for " + tr
            + " = " + total + " wound.");
        String there = cell(x, y);
        if (there == G_ORC || there == G_TROLL || there == G_BALROG) {
            setChange(x, y, G_FLOOR);
            monstersSlain = monstersSlain + 1;
            say("The " + there + " is undone by missile and trick.");
        }
        return total;
    }

    // =======================================================================
    // Heal — restore 1d40 + 6 per caster level to the hero.
    // =======================================================================
    int castHeal() {
        if (!alive) { return 0; }
        int amt = grimoire.healAmount(roll(1, grimoire.HEAL_DIE), level);
        health = health + amt;
        if (health > maxHealth) { health = maxHealth; }
        say("You cast HEAL (" + grimoire.healFormula() + ") — restored " + amt
            + " HP. (" + health + "/" + maxHealth + ")");
        return amt;
    }

    // =======================================================================
    // Heal Water — recalls all spent mana to its natural place and time, heals
    // the Universe, and rejuvenates Base Constitution at 99.6%.
    // =======================================================================
    void castHealWater() {
        if (!alive) { return; }
        int trueCon = statLib.STAT_MAX;                 // the body's true maximum
        int newCon = grimoire.healWaterConstitution(stats.con, trueCon);
        stats.con = newCon;
        // The body's rejuvenated Constitution lifts the hero's max health too.
        maxHealth = 24 + statLib.hpPerLevel(stats);
        say(grimoire.healWaterRead());
        say("Your Base Constitution is rejuvenated to " + stats.con
            + " (of a true " + trueCon + ").");
    }

    boolean fightBalrog(int x, int y) {
        int resolve = health + gold / 20 + monstersSlain * 2;
        int roll1 = roll(1, 100);
        say("A shadow and a flame. The Balrog of Moria bars the deep stair.");
        if (resolve >= 40 && roll1 >= 35) {
            say("\"You cannot pass!\" — and this time, it is YOU who says it.");
            setChange(x, y, G_FLOOR);
            stepHeroTo(x, y);
            monstersSlain = monstersSlain + 1;
            return true;
        }
        int dmg = roll(10, 25);
        health = health - dmg;
        say("The whip of flame bites for " + dmg + ". (" + health + " HP)");
        if (health <= 0) { die("the Balrog"); }
        return false;
    }

    void die(String by) {
        alive = false;
        say("You fall, slain by " + by + ", at depth " + depth + ".");
        say("The Mines keep their silence. (Careful next time, Adventurer.)");
    }

    // =======================================================================
    // Descending
    // =======================================================================

    void descend() {
        if (depth >= 8) {
            descended = true;
            say("Beyond the deep, the stair rises toward distant daylight.");
            say("You have crossed all eight levels of Moria. You LIVE.");
            return;
        }
        depth = depth + 1;

        // --- Level up: the body endures by Constitution --------------------
        level = level + 1;
        int hpGain = statLib.hpPerLevel(stats);  // CON-driven HP per level
        maxHealth = maxHealth + hpGain;
        int heal = roll(3, 8) + hpGain;
        health = health + heal;
        if (health > maxHealth) { health = maxHealth; }
        // A fresh weapon is scavenged from the deeper hall (often +4 or greater).
        Weapon found = armoury.forge(nextRng() % armoury.catalogSize(), depth);
        boolean upgraded = false;
        if (found.bonus >= weapon.bonus) { weapon = found; upgraded = true; }
        // A ranged arm may also turn up — a bow or crossbow (+3..+28, 2d12+8).
        Weapon foundRanged = armoury.forgeRanged(nextRng() % armoury.rangedCatalogSize(), depth);
        boolean upgradedRanged = false;
        if (foundRanged.bonus >= sidearm.bonus) { sidearm = foundRanged; upgradedRanged = true; }
        // Record this level-up in the SAVED leveling ledger.
        book.recordLevel(level, hpGain, 3,
            "Descended to depth " + depth + " (CON granted +" + hpGain + " HP).");

        say("You take the stair down. Depth " + depth
            + ". Level " + level + " — you catch your breath (+" + heal + " HP).");
        if (upgraded) {
            say("Deep in the rubble you find the " + found.name
                + " (d" + found.dieSides + " +" + found.bonus + ") — you take it up.");
        }
        if (upgradedRanged) {
            say("Among the fallen you recover the " + foundRanged.name
                + " (range " + foundRanged.range + " sq, 2d12+8 +"
                + foundRanged.bonus + ") — a finer shot.");
        }
        carveLevel();
        remusterForDepth();      // the Fellowship follows you down the Mines
        summonLord();            // a new named legend may hold this deeper hall
        if (depth == 4) {
            say("A prickle at the neck: something named now stalks the deep.");
        }
    }

    // =======================================================================
    // The scrollback chronicle (struct linked list)
    // =======================================================================

    void say(String line) {
        if (line == null) { return; }
        Msg m = new Msg();
        m.text = line;
        m.next = null;
        if (logHead == null) { logHead = m; logTail = m; }
        else { logTail.next = m; logTail = m; }
        logCount = logCount + 1;
    }

    int logLines() { return logCount; }

    // The i-th chronicle line (0 = oldest). Walks the list.
    String logAt(int i) {
        if (i < 0 || i >= logCount) { return ""; }
        Msg m = logHead;
        int k = 0;
        while (k < i && m != null) { m = m.next; k = k + 1; }
        if (m == null) { return ""; }
        return m.text;
    }

    // The most recent `n` lines, newest last, joined by newlines.
    String recentLog(int n) {
        int start = logCount - n;
        if (start < 0) { start = 0; }
        String out = "";
        int i = start;
        while (i < logCount) {
            String line = logAt(i);
            if (out == "") { out = line; } else { out = out + "\n" + line; }
            i = i + 1;
        }
        return out;
    }

    // =======================================================================
    // Text rendering (the authoritative headless read)
    // =======================================================================

    // Fog of war: cells beyond the torch radius read as dark; remembered walls
    // stay faintly drawn. The lit circle follows the hero.
    String visibleGlyph(int x, int y) {
        int dx = x - heroX; if (dx < 0) { dx = 0 - dx; }
        int dy = y - heroY; if (dy < 0) { dy = 0 - dy; }
        int dist = dx + dy;              // Manhattan torchlight (cheap + readable)
        if (dist > torch) {
            if (isWall(x, y)) { return G_WALL; }
            return G_DARK;
        }
        return cell(x, y);
    }

    // One row of the map, with the hero and the figuring pieces overlaid.
    // The hero always wins a cell; otherwise an active figure within torchlight
    // paints its glyph over the terrain; otherwise the fog-of-war terrain shows.
    String renderRow(int y) {
        String row = "";
        int x = 0;
        while (x < W) {
            if (x == heroX && y == heroY && alive) { row = row + G_HERO; }
            else { row = row + figureOrTerrain(x, y); }
            x = x + 1;
        }
        return row;
    }

    // A figure's glyph if one stands on a lit cell here, else the fog-of-war
    // terrain glyph. Figures beyond the torch radius fade into the dark, like
    // everything else, so the torchlight rule stays consistent.
    String figureOrTerrain(int x, int y) {
        int dx = x - heroX; if (dx < 0) { dx = 0 - dx; }
        int dy = y - heroY; if (dy < 0) { dy = 0 - dy; }
        int dist = dx + dy;
        if (dist <= torch) {
            String fg = figureGlyphAt(x, y);
            if (fg != null) { return fg; }
        }
        return visibleGlyph(x, y);
    }

    // The whole map as a newline-joined block.
    String renderGrid() {
        String out = "";
        int y = 0;
        while (y < H) {
            if (y == 0) { out = renderRow(y); } else { out = out + "\n" + renderRow(y); }
            y = y + 1;
        }
        return out;
    }

    // The HUD status line.
    String statusLine() {
        return heroName + "  L" + level + "   depth " + depth + "/8   HP "
             + health + "/" + maxHealth
             + "   gold " + gold + "   slain " + monstersSlain
             + "   torch " + torch + "   turn " + turns;
    }

    // =======================================================================
    // Queries for the GUI front-end
    // =======================================================================

    String name() { return heroName; }
    int currentDepth() { return depth; }
    int hp() { return health; }
    int hpMax() { return maxHealth; }
    int goldCount() { return gold; }
    int slain() { return monstersSlain; }
    int torchRadius() { return torch; }
    int turnCount() { return turns; }
    int heroCol() { return heroX; }
    int heroRow() { return heroY; }
    int width() { return W; }
    int height() { return H; }
    // The effective terrain glyph at a cell (mutation or procedural base), for
    // the GUI and the self-check — no hero/figure overlay.
    String cellGlyph(int x, int y) { return cell(x, y); }
    boolean isAlive() { return alive; }

    // --- RPG query accessors (stats, level, weapon, spell) -----------------
    int level_() { return level; }
    int statStr() { return stats.str; }
    int statDex() { return stats.dex; }
    int statCon() { return stats.con; }   // Constitution
    int statInt() { return stats.intel; }
    int statWis() { return stats.wis; }
    int statChr() { return stats.chr; }   // Character — the Number
    int truthPercent() { return statLib.truthPercent(stats); }
    boolean numbersTrue() { return statLib.numbersAreTrue(stats); }
    String statLine() { return statLib.describe(stats); }
    String weaponName() { return weapon.name; }
    int weaponBonus() { return weapon.bonus; }
    boolean weaponFinePlus() { return weapon.bonus >= 4; }
    // --- the ranged sidearm (a crossbow or bow): >= 8 sq, +3..+28, 2d12+8 ---
    String sidearmName() { return sidearm.name; }
    int sidearmRange() { return sidearm.range; }
    int sidearmBonus() { return sidearm.bonus; }
    int sidearmAverage() { return armoury.rangedAverage(sidearm); }
    boolean sidearmIsCrossbow() { return armoury.isCrossbow(sidearm); }
    // The signature Mace + the incurrence-radius model.
    String maceFormula() { return armoury.maceFormula(); }
    int maceAverage() { return armoury.maceAverage(); }
    boolean mutualPlus() { return armoury.mutualPlus(); }
    int weaponToHitBonus() { return armoury.toHitBonus(weapon); }
    int radiusLevelsHere() { return armoury.radiusLevels(weapon.bonus, depth); }
    int extraPotentialHere() { return armoury.extraPotential(weapon.bonus, depth); }
    int extraPotentialAt(int bonus, int atDepth) {
        return armoury.extraPotential(bonus, atDepth);
    }
    String fireballFormula() { return spellLib.fireballFormula(); }
    // The Fireball damage for a given die roll at the hero's current level.
    int fireballDamageFor(int dieRoll) {
        return spellLib.fireballDamage(dieRoll, level, statLib.spellPower(stats));
    }
    // Does Fireball assume Trick at the hero's level (past level 6)?
    boolean fireballAssumesTrick() { return grimoire.fireballAssumesTrick(level); }
    String healFormula() { return grimoire.healFormula(); }
    String trickFormula() { return grimoire.trickFormula(); }

    // --- the named legend holding this depth (the bestiary) ----------------
    boolean hasLord() { return lord != null; }
    String lordName() { if (lord == null) { return "none"; } return lord.name; }
    String lordTitle() { if (lord == null) { return ""; } return lord.title; }
    String lordSpecies() { if (lord == null) { return ""; } return lord.species; }
    int lordCr() { if (lord == null) { return 0; } return lord.cr; }
    int lordHp() { if (lord == null) { return 0; } return lord.hp; }
    int lordNativeDepth() { if (lord == null) { return 0; } return lord.nativeDepth; }
    int legendCount() { return bestiary.COUNT; }
    String legendRosterLine(int i) { return bestiary.rosterLine(i); }

    // --- class + castings (the Grimoire) -----------------------------------
    int heroClass_() { return heroClass; }
    String heroClassName() { return grimoire.className(heroClass); }
    int knownCastings() { return grimoire.spellsForClass(heroClass); }
    boolean heroIsCaster() { return grimoire.isCaster(heroClass); }
    boolean heroCanCast(int grimoireIndex) {
        return grimoire.classCanCast(heroClass, grimoireIndex);
    }
    int grimoireCount() { return grimoire.GRIMOIRE_COUNT; }
    String grimoireLine(int i) {
        return grimoire.describeCasting(grimoire.castingAt(i));
    }
    // Set the hero's class (Fighter/Mage/Cleric/Wizard).
    void setHeroClass(int cls) { heroClass = cls; }

    // --- the creation generator: lifetime feats (the "snuff") carried in ---
    int heroStanding_() { return heroStanding; }
    int heroFeats_() { return heroFeats; }
    boolean heroHasFeat(int feat) { return creator.hasBit(heroFeats, feat); }
    // A readable list of the hero's lifetime feats, from the bitmask.
    String heroFeatList() {
        String out = "";
        if (heroHasFeat(creator.FEAT_LAW_DEGREE))    { out = csvAdd(out, "Law Degree"); }
        if (heroHasFeat(creator.FEAT_UNI_TRUSTS))    { out = csvAdd(out, "Trusts of Universities"); }
        if (heroHasFeat(creator.FEAT_GREAT_WEALTH))  { out = csvAdd(out, "Great Wealth"); }
        if (heroHasFeat(creator.FEAT_EXCEPTION))     { out = csvAdd(out, "Exception Institute"); }
        if (heroHasFeat(creator.FEAT_KNIGHTHOOD))    { out = csvAdd(out, "Knighthood (by Law)"); }
        if (heroHasFeat(creator.FEAT_ENDOWED_CHAIR)) { out = csvAdd(out, "Endowed Chair"); }
        if (out == "") { out = "none"; }
        return out;
    }
    String csvAdd(String csv, String one) {
        if (csv == "") { return one; }
        return csv + ", " + one;
    }
    // Build a character via the generator, for a host to then adopt.
    MoriaCreator creationGenerator() { return creator; }

    // =======================================================================
    // The Lich obedience pact + the Spelling Duo.
    //   A lich (the lord, if it is a lich) may demand a pact. You must Agree,
    //   then Obey — which PAUSES the character — and are then prompted for a
    //   Spelling Duo: answer the real-life ORDER rightly to be freed.
    // =======================================================================

    // Does the current depth's lord demand an obedience pact? (Only liches do.)
    boolean lordIsLich() {
        if (lord == null) { return false; }
        return isLichSpecies(lord.species);
    }

    boolean isLichSpecies(String sp) {
        return sp == "Lich (Deity)" || sp == "Demilich"
            || sp == "Vampire / Undead" || sp == "Death Knight";
    }

    // The lich requests a pact; the duo posed is derived from the hero's turns
    // so it is deterministic.
    void lichRequestPact() {
        if (!lordIsLich()) { return; }
        int duo = turns % grimoire.DUO_COUNT;
        pact = grimoire.requestPact(lord.id, duo);
        say(lord.name + " demands an obedience pact. You must Agree. You must Obey.");
    }

    // You must Agree.
    void pactAgree() {
        if (pact == null) { return; }
        grimoire.agree(pact);
        say("You Agree to the pact of " + lord.name + ".");
    }

    // You must Obey — this pauses the character until the duo is answered.
    void pactObey() {
        if (pact == null) { return; }
        grimoire.obey(pact);
        if (grimoire.pausesCharacter(pact)) {
            say("You Obey. Your character is PAUSED, bound to the Lich's will.");
            say(grimoire.duoPrompt(pact.duoId));
        }
    }

    // The character is paused while obeying an unresolved pact.
    boolean characterPaused() {
        if (pact == null) { return false; }
        return grimoire.pausesCharacter(pact);
    }

    String spellingDuoPrompt() {
        if (pact == null) { return ""; }
        return grimoire.duoPrompt(pact.duoId);
    }

    // Answer the Spelling Duo. firstThenSecond == true means "the earlier event
    // precedes the later" — the right order. A right answer lifts the pause.
    boolean answerSpellingDuo(boolean firstThenSecond) {
        if (pact == null) { return false; }
        boolean freed = grimoire.resolvePact(pact, firstThenSecond);
        if (freed) {
            say("Rightly ordered — the pact is answered. The pause lifts; you "
                + "are free of the Lich's hold.");
            pact = null;
        } else {
            say("Wrongly ordered. The Lich keeps its hold — you remain Obey-bound.");
        }
        return freed;
    }

    // =======================================================================
    // Save / Load / Alter — persist the hero and the dungeon's creatures,
    // keeping the saved previous leveling work.
    // =======================================================================

    // Sync the current hero + the live creatures (figures and the base
    // monsters near the hero) into the save book, then serialize to a blob.
    String saveGame() {
        book.setCharacter(heroName, level, gold, statLib.serialize(stats));
        // Record the figuring pieces as saveable creatures.
        int i = 0;
        while (i < figureCount) {
            Figure f = figureIndex(i);
            if (f != null && f.active) {
                book.addCreature(f.name, depth, f.x, f.y, 20,
                    12, 12, 12, 10, 10, 20);
            }
            i = i + 1;
        }
        return book.save();
    }

    // ALTER a saved creature's stats through the book (Save/Load/Alter).
    boolean alterCreatureStats(int id, int s, int d, int c, int in, int w, int ch) {
        return book.alterCreatureStats(id, s, d, c, in, w, ch);
    }

    int savedLevels() { return book.levelsRecorded(); }
    String savedLedger() { return book.renderLedger(); }
    boolean saveLooksValid(String blob) { return book.looksValid(blob); }
    boolean hasWon() { return descended; }
    boolean over() { return !alive || descended; }

    // --- Figuring-piece queries for the GUI front-end ----------------------
    int figures_() { return figureCount; }

    // The i-th figure node (0-based), walking the list; null if out of range.
    Figure figureIndex(int i) {
        if (i < 0 || i >= figureCount) { return null; }
        Figure f = figures;
        int k = 0;
        while (k < i && f != null) { f = f.next; k = k + 1; }
        return f;
    }

    String figureName(int i)  { Figure f = figureIndex(i); if (f == null) { return ""; } return f.name; }
    String figureGlyph(int i) { Figure f = figureIndex(i); if (f == null) { return ""; } return f.glyph; }
    String figureRole(int i)  { Figure f = figureIndex(i); if (f == null) { return ""; } return f.role; }
    int figureCol(int i)      { Figure f = figureIndex(i); if (f == null) { return 0; } return f.x; }
    int figureRow(int i)      { Figure f = figureIndex(i); if (f == null) { return 0; } return f.y; }
    boolean figureActive(int i)   { Figure f = figureIndex(i); if (f == null) { return false; } return f.active; }
    boolean figureFriendly(int i) { Figure f = figureIndex(i); if (f == null) { return false; } return f.friendly; }

    // A readable roster block for the headless read and the UI's figure panel:
    // each Original Character's glyph, name, role, and current position (or a
    // note that it is not on this depth).
    String renderRoster() {
        String out = "The Figuring Pieces — Original Characters on the board:";
        int i = 0;
        while (i < figureCount) {
            Figure f = figureIndex(i);
            if (f != null) {
                String where = "";
                if (f.active) { where = "(" + f.x + "," + f.y + ")"; }
                else { where = "(not on this depth)"; }
                out = out + "\n  " + f.glyph + "  " + pad(f.name, 14)
                    + " " + pad(f.role, 28) + " " + where;
            }
            i = i + 1;
        }
        return out;
    }

    // Pad a string with spaces to at least `n` characters (left-aligned).
    String pad(String s, int n) {
        String out = s;
        int len = s.length();
        while (len < n) { out = out + " "; len = len + 1; }
        return out;
    }

    // =======================================================================
    // A scripted self-descent, for `make run` and the self-check. Deterministic:
    // walk the hero toward each stair, fighting what blocks the way, until the
    // game is over or a step budget is spent.
    // =======================================================================

    void autoDescend(int stepBudget) {
        int steps = 0;
        while (!over() && steps < stepBudget) {
            // First, if a monster stands down the hall within bow/crossbow
            // range, open with a ranged shot rather than closing to melee.
            tryRangedShot();
            boolean moved = false;
            // Toward the stair row first, then rightward toward the stair column.
            if (heroY < stairY) { moved = move(0, 1); }
            else if (heroY > stairY) { moved = move(0, 0 - 1); }
            if (!moved && !over()) { moved = move(1, 0); }
            if (!moved && !over()) { moved = move(1, nudgeRow()); }
            if (!moved && !over()) { moved = move(0, 1); }
            if (!moved && !over()) { moved = move(0, 0 - 1); }
            steps = steps + 1;
        }
    }

    // Scan rightward along the hero's row; if the nearest monster is within the
    // sidearm's range (>= 8 squares of reach), loose a shot at it. Returns true
    // if a shot was taken.
    boolean tryRangedShot() {
        int step = 1;
        while (step <= sidearm.range) {
            int tx = heroX + step;
            if (!inBounds(tx, heroY)) { return false; }
            if (isWall(tx, heroY)) { return false; }   // the shot is blocked
            String there = cell(tx, heroY);
            if (there == G_ORC)    { return fireAt(tx, heroY, "orc", step); }
            if (there == G_TROLL)  { return fireAt(tx, heroY, "troll", step); }
            if (there == G_BALROG) { return false; }    // the Balrog is met in person
            step = step + 1;
        }
        return false;
    }

    int nudgeRow() {
        int r = roll(0, 2);
        if (r == 0) { return 0; }
        if (r == 1) { return 1; }
        return 0 - 1;
    }

    void main() {
        begin("Adventurer", 1428);
        autoDescend(600);
        print("Moria — the Careful Years of Time");
        print("==================================");
        print(renderGrid());
        print("");
        print(statusLine());
        print("");
        print("Character sheet — level " + level_() + " " + heroClassName());
        print("  " + statLine());
        print("  castings known: " + knownCastings() + " of "
            + grimoireCount() + " (Fighters get swords only)");
        print("  standing " + heroStanding_() + "   lifetime feats: " + heroFeatList());
        print("  weapon: " + weaponName() + "  (" + maceFormula()
            + ", +" + weaponBonus() + " mutual)");
        print("  enchant radius here (depth " + currentDepth() + "): "
            + radiusLevelsHere() + " levels, up to " + extraPotentialHere()
            + " extra damage");
        print("  sidearm: " + sidearmName() + " (range " + sidearmRange()
            + " sq, 2d12+8 +" + sidearmBonus() + ", avg " + sidearmAverage() + ")");
        print("  fireball: " + fireballFormula());
        if (hasLord()) {
            print("  the lord of this depth: " + lordName() + " ("
                + lordSpecies() + ", CR " + lordCr() + ", HP " + lordHp() + ")");
        }
        print("");
        print(savedLedger());
        print("");
        print(renderRoster());
        print("");
        print("Recent chronicle:");
        print(recentLog(6));
        if (hasWon()) {
            print("");
            print("RESULT: You crossed all eight levels and lived. Excellent.");
        } else if (!isAlive()) {
            print("");
            print("RESULT: You fell in the dark. The Mines keep their silence.");
        } else {
            print("");
            print("RESULT: The descent continues (step budget spent).");
        }
    }
}
