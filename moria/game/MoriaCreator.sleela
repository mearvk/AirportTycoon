#sleela 1.6
//
// Moria — The Character-Creation Generator
// ========================================
// Make an Adventurer. The generator offers three ALLOWANCES for the base
// ability scores, and a set of LIFETIME FEATS — the "snuff": the great feats of
// a lifetime, several of them won BY LAW too — that grant creation bonuses.
//
// Base-stat allowances:
//   1. ROLLED      — fresh scores, 4d6-drop-low feel, from the seeded stream.
//   2. POINT-SET   — you supply the six base scores directly (a chosen build).
//   3. OLD WISDOMS — carry forward a seasoned baseline: the accumulated life
//                    favours Wisdom and the Character Number, so a veteran soul
//                    starts wiser and reads TRUER than a fresh recruit.
//
// Lifetime feats (the snuff — great feats of a lifetime, won by law too):
//   * Law Degree          — read for the law: +INT, +WIS, +standing.
//   * Trusts of Universities — scholarly trusts/endowments: +INT, +WIS, +gold.
//   * Great Wealth        — a fortune: +gold (a lot), +Character (standing).
//   * Exception Institute — an exceptional institution: +Character#, +WIS —
//                           the exception that makes the whole sheet TRUER.
//   * Knighthood (by Law) — honoured in law: +STR, +Character, +standing.
//   * Endowed Chair       — a professor's chair: +INT, +WIS, +gold.
//
// A built character is a Character struct carrying its final stat block, its
// starting gold, a civic "standing" score, and the feats it was granted.
// No arrays: feats are a bitmask of FEAT_*, stat blocks come from MoriaStats.

// A freshly created Adventurer (reference struct).
struct Creature0 {
    String   name;
    int      str;
    int      dex;
    int      con;
    int      intel;
    int      wis;
    int      chr;        // Character — the Number
    int      gold;       // starting gold
    int      standing;   // civic standing earned by lifetime feats
    int      feats;      // bitmask of FEAT_*
    int      allowance;  // which base allowance built it (ALLOW_*)
    // Richer lifetime-feat effects:
    int      intTempBonus;   // temporary INT (Exception Institute: +1000, 5 hrs)
    int      intTempMinutes; // minutes the temporary INT lasts
    int      intPermBonus;   // permanent INT crumble pool (Endowed Chair: +8000)
    int      kingdoms;       // kingdoms granted (Exception Institute: 2)
    int      followers;      // level-36 follower NPCs (Exception Institute: 2)
    int      politicalLevels;// Democrat/Socialist track (Uni Trusts: +5)
}

class MoriaCreator {

    MoriaStats statLib;
    void begin() { statLib = new MoriaStats(); }

    // --- Base-stat allowances ---------------------------------------------
    static int ALLOW_ROLLED      = 1;  // rolled fresh
    static int ALLOW_POINT_SET   = 2;  // supplied directly
    static int ALLOW_OLD_WISDOMS = 3;  // carried-forward seasoned baseline

    // --- Lifetime feats (the "snuff") — a bitmask of distinct powers of two --
    static int FEAT_LAW_DEGREE   = 1;   // won by law
    static int FEAT_UNI_TRUSTS   = 2;   // trusts of universities
    static int FEAT_GREAT_WEALTH = 4;   // great wealth
    static int FEAT_EXCEPTION    = 8;   // exception institute
    static int FEAT_KNIGHTHOOD   = 16;  // knighthood (by law)
    static int FEAT_ENDOWED_CHAIR= 32;  // an endowed chair
    static int FEAT_COUNT = 6;

    // --- Decreed feat numbers ----------------------------------------------
    // Great Wealth: summons 1000x your estimable wealth from a known relation
    // to a Kingdom (or Great Kingdom); at least 20,000 gold coins.
    static int WEALTH_MULT     = 1000;   // 1000x your estimable wealth
    static int WEALTH_FLOOR    = 20000;  // ...but never less than 20,000 coins
    // Trusts of Universities: your Democrat and Socialist track moves +5 levels
    // ("roll 1d0 + 5 to start" — a flat +5, since 1d0 contributes nothing).
    static int UNI_POLITICAL_LEVELS = 5;
    // Exception Institute: Character gains 1000+ INT for 5 hours, with 2
    // Kingdoms and 2 Kids/followers. Followers are level-36 NPCs; the summon
    // lasts 28 rounds per summoner level (~28 minutes per caster level).
    static int EXC_INT_BONUS    = 1000;  // +1000 temporary INT
    static int EXC_INT_HOURS    = 5;     // for 5 hours
    static int EXC_KINGDOMS     = 2;     // 2 kingdoms
    static int EXC_FOLLOWERS    = 2;     // 2 kids / followers
    static int FOLLOWER_LEVEL   = 36;    // followers are level-36 NPCs
    static int SUMMON_ROUNDS_PER_LEVEL = 28; // 28 rounds (~minutes) per level
    // Endowed Chair: +8000 permanent INT (a crumble pool). You fail some number
    // of times in 1000 moves; once the effective 8000 crumbles the boost fades,
    // usually in 1-2 minutes.
    static int CHAIR_INT_BONUS  = 8000;  // +8000 permanent INT (crumbles)
    static int CHAIR_FADE_MIN   = 1;     // fades in 1..2 minutes once crumbled
    static int CHAIR_FADE_MAX   = 2;

    // ------------------------------------------------------------------
    // Base allowance 1: ROLLED scores from the seeded stream.
    // ------------------------------------------------------------------
    Creature0 rollBase(String who, int a, int b, int c, int d, int e, int f) {
        if (statLib == null) { statLib = new MoriaStats(); }
        StatBlock s = statLib.fromSeeded(a, b, c, d, e, f);
        return assemble(who, s.str, s.dex, s.con, s.intel, s.wis, s.chr,
                        ALLOW_ROLLED);
    }

    // ------------------------------------------------------------------
    // Base allowance 2: POINT-SET — the player supplies the six base scores.
    // Each is clamped to the legal band.
    // ------------------------------------------------------------------
    Creature0 pointSet(String who, int str, int dex, int con,
                       int intel, int wis, int chr) {
        return assemble(who, str, dex, con, intel, wis, chr, ALLOW_POINT_SET);
    }

    // ------------------------------------------------------------------
    // Base allowance 3: OLD WISDOMS — a seasoned baseline. A veteran soul
    // carries accumulated life: solid, even scores with a lift to Wisdom and a
    // notably higher Character Number, so the sheet already reads truer than a
    // fresh recruit's. `years` deepens the wisdom (and the Character Number).
    // ------------------------------------------------------------------
    Creature0 oldWisdoms(String who, int years) {
        int y = years; if (y < 0) { y = 0; }
        int wisLift = 2 + y / 4;            // wisdom grows with the years
        int chrLift = 6 + y / 2;            // the Number grows faster
        return assemble(who,
            11,                              // STR — steady
            11,                              // DEX — steady
            12,                              // CON — endured
            12,                              // INT — learned
            12 + wisLift,                    // WIS — the old wisdom
            14 + chrLift,                    // CHR# — a life well-accounted
            ALLOW_OLD_WISDOMS);
    }

    // Build the base Creature0 (no feats yet), clamping every score.
    Creature0 assemble(String who, int str, int dex, int con,
                       int intel, int wis, int chr, int allowance) {
        if (statLib == null) { statLib = new MoriaStats(); }
        Creature0 g = new Creature0();
        g.name = who;
        g.str   = statLib.clampStat(str);
        g.dex   = statLib.clampStat(dex);
        g.con   = statLib.clampStat(con);
        g.intel = statLib.clampStat(intel);
        g.wis   = statLib.clampStat(wis);
        g.chr   = statLib.clampStat(chr);
        g.gold  = 50;                        // a modest purse to start
        g.standing = 0;
        g.feats = 0;
        g.allowance = allowance;
        g.intTempBonus = 0;
        g.intTempMinutes = 0;
        g.intPermBonus = 0;
        g.kingdoms = 0;
        g.followers = 0;
        g.politicalLevels = 0;
        return g;
    }

    // ------------------------------------------------------------------
    // Lifetime feats — grant a feat and apply its bonuses to the character.
    // Each feat is applied once (idempotent via the bitmask).
    // ------------------------------------------------------------------
    void grantFeat(Creature0 g, int feat) {
        if (g == null) { return; }
        if (hasFeat(g, feat)) { return; }    // already granted — no double-dip
        g.feats = g.feats + feat;            // set the bit (distinct powers of 2)

        if (feat == FEAT_LAW_DEGREE) {
            // Read for the law: sharpened mind, measured judgement, standing.
            g.intel = statLib.clampStat(g.intel + 2);
            g.wis   = statLib.clampStat(g.wis + 2);
            g.standing = g.standing + 20;
            g.gold = g.gold + 200;
        } else if (feat == FEAT_UNI_TRUSTS) {
            // Trusts of universities: scholarship and an endowment, and your
            // forward Democrat and Socialist track moves ahead +5 levels
            // ("roll 1d0 + 5 to start" — a flat +5).
            g.intel = statLib.clampStat(g.intel + 3);
            g.wis   = statLib.clampStat(g.wis + 1);
            g.gold = g.gold + 1200;          // the endowment
            g.standing = g.standing + 15;
            g.politicalLevels = g.politicalLevels + UNI_POLITICAL_LEVELS;
        } else if (feat == FEAT_GREAT_WEALTH) {
            // Great Wealth: summons 1000x your estimable wealth from a known
            // relation to a Kingdom (or Great Kingdom) — at least 20,000 coins.
            g.gold = g.gold + greatWealthSummon(g.gold);
            g.chr  = statLib.clampStat(g.chr + 2);
            g.standing = g.standing + 25;
        } else if (feat == FEAT_EXCEPTION) {
            // Exception Institute: Character gains 1000+ INT for 5 hours, 2
            // Kingdoms, and 2 Kids/followers (level-36 NPCs). The institution
            // also makes the whole sheet TRUER (a lift to the Character Number).
            g.intTempBonus = g.intTempBonus + EXC_INT_BONUS;   // +1000 temp INT
            g.intTempMinutes = EXC_INT_HOURS * 60;             // for 5 hours
            g.kingdoms = g.kingdoms + EXC_KINGDOMS;            // 2 kingdoms
            g.followers = g.followers + EXC_FOLLOWERS;         // 2 followers (L36)
            g.chr = statLib.clampStat(g.chr + 6);
            g.wis = statLib.clampStat(g.wis + 2);
            g.standing = g.standing + 30;
        } else if (feat == FEAT_KNIGHTHOOD) {
            // Knighthood, honoured in law: arm, bearing, standing.
            g.str = statLib.clampStat(g.str + 2);
            g.chr = statLib.clampStat(g.chr + 2);
            g.standing = g.standing + 20;
        } else if (feat == FEAT_ENDOWED_CHAIR) {
            // Endowed Chair: +8000 PERMANENT INT (a crumble pool that erodes
            // over play), plus a stipend and standing.
            g.intPermBonus = g.intPermBonus + CHAIR_INT_BONUS; // +8000 INT pool
            g.wis   = statLib.clampStat(g.wis + 2);
            g.gold  = g.gold + 2500;
            g.standing = g.standing + 18;
        }
    }

    // Grant several feats at once (a bitmask of FEAT_*).
    void grantFeats(Creature0 g, int featMask) {
        if (hasBit(featMask, FEAT_LAW_DEGREE))    { grantFeat(g, FEAT_LAW_DEGREE); }
        if (hasBit(featMask, FEAT_UNI_TRUSTS))    { grantFeat(g, FEAT_UNI_TRUSTS); }
        if (hasBit(featMask, FEAT_GREAT_WEALTH))  { grantFeat(g, FEAT_GREAT_WEALTH); }
        if (hasBit(featMask, FEAT_EXCEPTION))     { grantFeat(g, FEAT_EXCEPTION); }
        if (hasBit(featMask, FEAT_KNIGHTHOOD))    { grantFeat(g, FEAT_KNIGHTHOOD); }
        if (hasBit(featMask, FEAT_ENDOWED_CHAIR)) { grantFeat(g, FEAT_ENDOWED_CHAIR); }
    }

    boolean hasFeat(Creature0 g, int feat) {
        if (g == null) { return false; }
        return hasBit(g.feats, feat);
    }

    // ------------------------------------------------------------------
    // Decreed feat helpers.
    // ------------------------------------------------------------------

    // Great Wealth: 1000x your estimable wealth, floored at 20,000 coins.
    // `estimable` is the character's wealth before the summon (its purse).
    int greatWealthSummon(int estimable) {
        int base = estimable;
        if (base < 0) { base = 0; }
        int summoned = base * WEALTH_MULT;      // 1000x
        if (summoned < WEALTH_FLOOR) { summoned = WEALTH_FLOOR; }  // >= 20,000
        return summoned;
    }

    int followerLevel() { return FOLLOWER_LEVEL; }   // level-36 NPCs

    // The Exception Institute summon duration: 28 rounds per summoner level
    // (~28 minutes per caster level).
    int summonRounds(int summonerLevel) {
        int lv = summonerLevel; if (lv < 1) { lv = 1; }
        return SUMMON_ROUNDS_PER_LEVEL * lv;
    }
    int summonMinutes(int summonerLevel) { return summonRounds(summonerLevel); }

    // Endowed Chair crumble: the +8000 INT pool erodes as moves are made and
    // some fail. `movesMade` of 1000 and `failures` among them wear the pool
    // down; each failed move crumbles a slice. Returns the INT still standing.
    int chairStanding(Creature0 g, int movesMade, int failures) {
        if (g == null || g.intPermBonus <= 0) { return 0; }
        int pool = g.intPermBonus;              // 8000
        // Each of the ~1000 moves wears a little; a failure wears much more.
        int wear = movesMade + failures * (pool / 1000);
        int left = pool - wear;
        if (left < 0) { left = 0; }
        return left;
    }

    // Once the effective 8000 has crumbled to nothing, the boost fades in 1..2
    // minutes. `rollValue` is a seeded 0.. value for the 1-or-2 choice.
    int chairFadeMinutes(int rollValue) {
        int r = rollValue; if (r < 0) { r = 0 - r; }
        return CHAIR_FADE_MIN + rem(r, CHAIR_FADE_MAX - CHAIR_FADE_MIN + 1);
    }

    // The character's EFFECTIVE Intelligence right now: base INT, plus any
    // still-standing permanent-chair pool, plus the temporary Exception bonus
    // while it lasts (minutesElapsed < intTempMinutes).
    int effectiveInt(Creature0 g, int chairLeft, int minutesElapsed) {
        if (g == null) { return 0; }
        int v = g.intel + chairLeft;
        if (minutesElapsed < g.intTempMinutes) { v = v + g.intTempBonus; }
        return v;
    }

    // Is a single power-of-two bit set within a mask? SLeeLa 1.6: arithmetic
    // only, no bit-ops — the same test the Grimoire uses.
    boolean hasBit(int mask, int bit) {
        if (bit <= 0) { return false; }
        int lower = rem(mask, bit * 2);
        return lower >= bit;
    }
    int rem(int a, int b) {
        if (b <= 0) { return 0; }
        return a - (a / b) * b;
    }

    // ------------------------------------------------------------------
    // Names + readouts.
    // ------------------------------------------------------------------
    String allowanceName(int a) {
        if (a == ALLOW_ROLLED)      { return "Rolled"; }
        if (a == ALLOW_POINT_SET)   { return "Point-set"; }
        if (a == ALLOW_OLD_WISDOMS) { return "Old Wisdoms"; }
        return "Unknown";
    }

    String featName(int feat) {
        if (feat == FEAT_LAW_DEGREE)    { return "Law Degree"; }
        if (feat == FEAT_UNI_TRUSTS)    { return "Trusts of Universities"; }
        if (feat == FEAT_GREAT_WEALTH)  { return "Great Wealth"; }
        if (feat == FEAT_EXCEPTION)     { return "Exception Institute"; }
        if (feat == FEAT_KNIGHTHOOD)    { return "Knighthood (by Law)"; }
        if (feat == FEAT_ENDOWED_CHAIR) { return "Endowed Chair"; }
        return "(none)";
    }

    // A comma-list of the feats a character holds.
    String featList(Creature0 g) {
        String out = "";
        if (hasFeat(g, FEAT_LAW_DEGREE))    { out = add(out, featName(FEAT_LAW_DEGREE)); }
        if (hasFeat(g, FEAT_UNI_TRUSTS))    { out = add(out, featName(FEAT_UNI_TRUSTS)); }
        if (hasFeat(g, FEAT_GREAT_WEALTH))  { out = add(out, featName(FEAT_GREAT_WEALTH)); }
        if (hasFeat(g, FEAT_EXCEPTION))     { out = add(out, featName(FEAT_EXCEPTION)); }
        if (hasFeat(g, FEAT_KNIGHTHOOD))    { out = add(out, featName(FEAT_KNIGHTHOOD)); }
        if (hasFeat(g, FEAT_ENDOWED_CHAIR)) { out = add(out, featName(FEAT_ENDOWED_CHAIR)); }
        if (out == "") { out = "none"; }
        return out;
    }

    String add(String csv, String one) {
        if (csv == "") { return one; }
        return csv + ", " + one;
    }

    // Build the final StatBlock (for handing to the dungeon/MoriaStats).
    StatBlock statBlock(Creature0 g) {
        return statLib.make(g.str, g.dex, g.con, g.intel, g.wis, g.chr);
    }

    int truthPercent(Creature0 g) {
        return statLib.truthPercent(statBlock(g));
    }

    // A serialized line for the save system.
    String serialize(Creature0 g) {
        return "CHAR0|name=" + g.name
             + "|allow=" + g.allowance
             + "|str=" + g.str + "|dex=" + g.dex + "|con=" + g.con
             + "|int=" + g.intel + "|wis=" + g.wis + "|chr=" + g.chr
             + "|gold=" + g.gold + "|standing=" + g.standing
             + "|feats=" + g.feats;
    }

    String describe(Creature0 g) {
        String out = g.name + "  [" + allowanceName(g.allowance) + "]"
             + "\n    STR " + g.str + " DEX " + g.dex + " CON " + g.con
             + " INT " + g.intel + " WIS " + g.wis + " CHR# " + g.chr
             + "   (truth " + truthPercent(g) + "%)"
             + "\n    gold " + g.gold + "   standing " + g.standing
             + "\n    lifetime feats: " + featList(g);
        if (g.politicalLevels > 0) {
            out = out + "\n    Democrat/Socialist track: +" + g.politicalLevels
                + " levels";
        }
        if (g.intTempBonus > 0) {
            out = out + "\n    Exception Institute: +" + g.intTempBonus
                + " temp INT for " + (g.intTempMinutes / 60) + " hrs, "
                + g.kingdoms + " kingdoms, " + g.followers
                + " followers (level-" + FOLLOWER_LEVEL + " NPCs)";
        }
        if (g.intPermBonus > 0) {
            out = out + "\n    Endowed Chair: +" + g.intPermBonus
                + " permanent INT (crumbles over 1000 moves, then fades 1-2 min)";
        }
        return out;
    }

    // ------------------------------------------------------------------
    // Headless demo: all three allowances, and the lifetime feats.
    // ------------------------------------------------------------------
    void main() {
        begin();
        print("Moria — Character-Creation Generator");
        print("Allowances: Rolled, Point-set, or Old Wisdoms.");
        print("");

        // Allowance one: Rolled.
        Creature0 a = rollBase("Rolled Recruit", 1428, 90210, 70300, 31337, 5, 777);
        print(describe(a));
        print("");

        // Allowance two: Point-set.
        Creature0 b = pointSet("Chosen Build", 16, 14, 14, 12, 13, 15);
        print(describe(b));
        print("");

        // Allowance three: Old Wisdoms — a seasoned soul of 40 years.
        Creature0 c = oldWisdoms("Elder of the Deep", 40);
        print(describe(c));
        print("  (Old Wisdoms start wiser and read truer than a fresh recruit.)");
        print("");

        // The snuff: lifetime feats, several won by law. Grant the full set to
        // a distinguished soul and show the cumulative bonuses.
        Creature0 d = oldWisdoms("The Distinguished", 24);
        grantFeat(d, FEAT_LAW_DEGREE);
        grantFeat(d, FEAT_UNI_TRUSTS);
        grantFeat(d, FEAT_GREAT_WEALTH);
        grantFeat(d, FEAT_EXCEPTION);
        grantFeat(d, FEAT_KNIGHTHOOD);
        grantFeat(d, FEAT_ENDOWED_CHAIR);
        print("The snuff — a lifetime of great feats, won by law too:");
        print(describe(d));

        // The decreed feat numbers in detail.
        print("");
        print("Great Wealth summon: a purse of 50 becomes +"
            + greatWealthSummon(50) + " (1000x, floored at " + WEALTH_FLOOR + ").");
        print("  a purse of 100 would summon +" + greatWealthSummon(100)
            + " (1000x = 100,000).");
        print("Exception followers are level-" + followerLevel()
            + " NPCs; a level-5 summoner holds them " + summonRounds(5)
            + " rounds (~" + summonMinutes(5) + " min).");
        print("Endowed Chair +" + CHAIR_INT_BONUS + " INT crumbles: after 1000 "
            + "moves with 40 failures, " + chairStanding(d, 1000, 40)
            + " INT still stands.");
        print("  effective INT at hour 1 (temp still up): "
            + effectiveInt(d, chairStanding(d, 1000, 40), 60));
        print("  once crumbled, the chair's boost fades in "
            + chairFadeMinutes(1428) + " minute(s).");
    }
}
