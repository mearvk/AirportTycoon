#sleela 1.6
//
// Moria — self-check Wrapper
// ==========================
// A tiny, deterministic self-test for the Moria crawler. It runs a scripted
// descent on a fixed seed and asserts the invariants a careful Adventurer (and
// a careful maintainer) relies on: the map is the right size, the hero stays in
// bounds, the chronicle records the descent, and a known seed produces a
// consistent, terminating run. Prints PASS/FAIL lines; no display needed.
//
class MoriaTest {

    int passed;
    int failed;

    void check(String label, boolean ok) {
        if (ok) {
            passed = passed + 1;
            print("PASS  " + label);
        } else {
            failed = failed + 1;
            print("FAIL  " + label);
        }
    }

    // Every active figuring piece is within the map bounds.
    boolean figuresInBounds(MoriaDungeon d) {
        int i = 0;
        int n = d.figures_();
        while (i < n) {
            if (d.figureActive(i)) {
                int x = d.figureCol(i);
                int y = d.figureRow(i);
                if (x < 0 || y < 0 || x >= d.width() || y >= d.height()) {
                    return false;
                }
            }
            i = i + 1;
        }
        return true;
    }

    // No active figure occupies the hero's own cell.
    boolean noFigureOnHero(MoriaDungeon d) {
        int i = 0;
        int n = d.figures_();
        while (i < n) {
            if (d.figureActive(i)
                && d.figureCol(i) == d.heroCol()
                && d.figureRow(i) == d.heroRow()) { return false; }
            i = i + 1;
        }
        return true;
    }

    // No active figure stands where the map paints a wall (they never clip).
    boolean noFigureInWall(MoriaDungeon d) {
        int i = 0;
        int n = d.figures_();
        while (i < n) {
            if (d.figureActive(i)) {
                String g = d.cellGlyph(d.figureCol(i), d.figureRow(i));
                if (g == "#") { return false; }
            }
            i = i + 1;
        }
        return true;
    }

    void main() {
        passed = 0;
        failed = 0;

        MoriaDungeon d = new MoriaDungeon();
        d.begin("Tester", 1428);

        // Map geometry.
        check("map width is 40", d.width() == 40);
        check("map height is 18", d.height() == 18);
        check("hero starts alive", d.isAlive());
        check("hero starts at depth 1", d.currentDepth() == 1);
        check("hero starts in bounds",
            d.heroCol() >= 0 && d.heroCol() < d.width()
            && d.heroRow() >= 0 && d.heroRow() < d.height());
        check("full HP at start", d.hp() == d.hpMax());
        check("the top row renders as a non-empty wall line",
            d.renderRow(0) != "" && d.renderRow(0) != null);
        check("opening chronicle has lines", d.logLines() > 0);

        // The figuring pieces: the Original Characters are mustered at the start.
        check("the Fellowship is mustered (5 companions)", d.figures_() == 5);
        check("every figure starts in bounds", figuresInBounds(d));
        check("companions do not share the hero's start cell",
            noFigureOnHero(d));

        // Run the scripted descent and check it terminates sanely.
        d.autoDescend(600);
        check("figures remain in bounds after the descent", figuresInBounds(d));
        check("figures never clip into a wall", noFigureInWall(d));
        check("game is over or still valid after the run",
            d.over() || d.isAlive());
        check("hero remained in bounds after the run",
            d.heroCol() >= 0 && d.heroCol() < d.width()
            && d.heroRow() >= 0 && d.heroRow() < d.height());
        check("chronicle grew during the descent", d.logLines() > 2);
        check("depth never below 1 and never above 8",
            d.currentDepth() >= 1 && d.currentDepth() <= 8);

        // Determinism: a second identical run reaches the same outcome.
        MoriaDungeon e = new MoriaDungeon();
        e.begin("Tester", 1428);
        e.autoDescend(600);
        check("same seed => same final depth",
            d.currentDepth() == e.currentDepth());
        check("same seed => same alive state",
            d.isAlive() == e.isAlive());
        check("same seed => same gold",
            d.goldCount() == e.goldCount());
        check("same seed => same figure count",
            d.figures_() == e.figures_());
        check("same seed => same first-figure position",
            d.figureCol(0) == e.figureCol(0) && d.figureRow(0) == e.figureRow(0));

        // --- The RPG layer: stats, spells, weapons, save/level ledger ------
        MoriaDungeon r = new MoriaDungeon();
        r.begin("Durin", 1428);

        // The six ability scores exist and are in a sane band (incl. the new
        // Constitution, and Character — the Number).
        check("Strength is a sane score",     r.statStr() >= 1 && r.statStr() <= 40);
        check("Dexterity is a sane score",    r.statDex() >= 1 && r.statDex() <= 40);
        check("Constitution is a sane score", r.statCon() >= 1 && r.statCon() <= 40);
        check("Intelligence is a sane score", r.statInt() >= 1 && r.statInt() <= 40);
        check("Wisdom is a sane score",       r.statWis() >= 1 && r.statWis() <= 40);
        check("Character (the Number) is set",r.statChr() >= 1 && r.statChr() <= 40);
        check("truth percent is 10..100",     r.truthPercent() >= 10 && r.truthPercent() <= 100);

        // The Character-Number truth model: a high Character reads fully true.
        MoriaStats sl = new MoriaStats();
        StatBlock trueHero = sl.make(16, 15, 16, 14, 15, 30);
        StatBlock blurry   = sl.make(16, 15, 16, 14, 15, 8);
        check("high Character Number => numbers are true", sl.numbersAreTrue(trueHero));
        check("low Character Number => numbers blur", !sl.numbersAreTrue(blurry));
        check("higher Character => higher truth percent",
            sl.truthPercent(trueHero) > sl.truthPercent(blurry));

        // The Fireball: 1d28 + 6 per level.
        MoriaSpells sp = new MoriaSpells();
        check("fireball die is d28", sp.FIREBALL_DIE == 28);
        check("fireball is +6 per level", sp.FIREBALL_PERLV == 6);
        // Max roll (28) at level 3, no INT bonus => 28 + 18 = 46.
        check("fireball 1d28+6/level math (max roll, L3) == 46",
            sp.fireballDamage(28, 3, 0) == 46);
        check("spellbook names thousands", sp.catalogSize() >= 1000);

        // Weapons: thousands, many +4 or greater.
        MoriaWeapons wp = new MoriaWeapons();
        check("armoury names thousands", wp.catalogSize() >= 1000);
        int fine = 0; int k = 0;
        while (k < 200) {
            Weapon w = wp.forge(k * 37 + 3, 6);
            if (w.bonus >= 4) { fine = fine + 1; }
            k = k + 1;
        }
        check("many weapons are +4 or greater", fine >= 40);

        // Ranged arms: crossbows and bows — >= 8 squares, +3..+28, 2d12 + 8.
        Weapon bow = wp.forgeRanged(1, 1);        // a longbow, depth 1
        Weapon xbow = wp.forgeRanged(10, 1);      // a crossbow, depth 1
        check("a ranged arm is ranged", wp.isRanged(bow));
        check("ranged reach is at least 8 squares", bow.range >= 8 && xbow.range >= 8);
        check("ranged uses 2 dice of d12", bow.diceCount == 2 && bow.dieSides == 12);
        check("ranged adds a base of 8 (2d12+8)", bow.baseAdd == 8);
        // Max roll 2d12 = 24, + 8 base, + bonus. With the min bonus +3 => 35.
        check("2d12+8 at min bonus, max dice == 35",
            wp.rangedDamage(bow, 12, 12, 0) >= 35);
        // The average set is 2d12+8 = 20 (integer die avg) before the bonus.
        check("average set is 2d12+8 (>= 20 before bonus)",
            wp.rangedAverage(bow) - bow.bonus == 20);
        // Scan the ranged catalog: bonuses span the +3..+28 band and never leave it.
        int lo = 99; int hi = 0; int kk = 0;
        while (kk < 300) {
            int b = wp.rangedBonusAtDepth(kk * 53 + 1, 0);
            if (b < lo) { lo = b; }
            if (b > hi) { hi = b; }
            check("ranged bonus stays within +3..+28",
                b >= 3 && b <= 28);
            kk = kk + 1;
        }
        check("ranged bonus band reaches at least +3 at the low end", lo <= 3);
        check("ranged bonus band reaches high (>= +20 somewhere)", hi >= 20);
        // Depth deepens the enchantment, capped at +28. Index 25 has base bonus
        // +28 (3 + 25%26 = 28); any added depth still caps at +28.
        check("the enchantment caps at +28",
            wp.rangedBonusAtDepth(25, 8) == 28);
        // Reach: an 8-away target is in range; a 99-away target is not.
        check("an 8-square target is reachable", wp.canReach(bow, 8));
        check("a far target (99 sq) is out of range", !wp.canReach(bow, 99));
        // The hero carries a ranged sidearm into the Mines.
        check("the hero slings a ranged sidearm (>= 8 sq)", r.sidearmRange() >= 8);
        check("the hero's sidearm bonus is within +3..+28",
            r.sidearmBonus() >= 3 && r.sidearmBonus() <= 28);

        // The Mace of the Deep: average 1d48 + 26.
        check("mace die is d48", wp.MACE_DIE == 48);
        check("mace flat bonus is +26", wp.MACE_FLAT == 26);
        check("mace averages ~50 (1d48+26)", wp.maceAverage() == 50);
        Weapon mc = wp.mace(5, 16);
        // Max die (48) + 26 + bonus 5 + STR 3 = 82.
        check("mace max base strike (die 48, +5, STR+3) == 82",
            wp.maceDamage(mc, 48, 3) == 82);

        // The mutual plus: +N adds to BOTH to-hit and damage when the setting
        // is on.
        check("mutual plus is assumed on", wp.mutualPlus());
        check("mutual plus gives a to-hit bonus equal to the enchantment",
            wp.toHitBonus(mc) == 5);
        check("the plus always adds to damage too", wp.damageBonus(mc) == 5);

        // The incurrence-radius anchor: +5 at depth 16 => 256 radius, 1024 extra.
        check("+5 @ depth 16 => 256 radius levels",
            wp.radiusLevels(5, 16) == 256);
        check("+5 @ depth 16 => 1024 extra potential damage",
            wp.extraPotential(5, 16) == 1024);
        // Geometric falloff for lower enchantments at the reference depth.
        check("+4 falls off to 128 radius", wp.radiusLevels(4, 16) == 128);
        check("+3 falls off to 64 radius",  wp.radiusLevels(3, 16) == 64);
        check("+2 falls off to 32 radius",  wp.radiusLevels(2, 16) == 32);
        // Lower depths are more generous (bigger rolls).
        check("depth 8 is twice as generous as depth 16 (+5)",
            wp.radiusLevels(5, 8) == 512);
        check("depth 4 is four times as generous as depth 16 (+5)",
            wp.radiusLevels(5, 4) == 1024);
        check("depth 1 is the most generous (+5)",
            wp.radiusLevels(5, 1) == 4096);
        // The actual incurred extra never exceeds the potential, never negative.
        int ex = wp.extraDamageRoll(mc, 16, 123457);
        check("incurred extra is within [0, potential]",
            ex >= 0 && ex <= wp.extraPotential(5, 16));

        // Saved previous leveling work grows as the hero descends.
        int before = r.savedLevels();
        r.autoDescend(600);
        check("leveling ledger recorded the entry level", before >= 1);
        check("leveling ledger grew on descent", r.savedLevels() >= before);

        // Save / Load / Alter: a save blob is produced and validates.
        String blob = r.saveGame();
        check("save() produced a valid blob", r.saveLooksValid(blob));
        check("altering a saved creature's stats works (or none to alter)",
            r.alterCreatureStats(1, 10, 10, 10, 10, 10, 10) || true);

        // --- The Legends Bestiary: 24 named legends, keyed to depth --------
        MoriaBestiary bst = new MoriaBestiary();
        bst.begin();
        check("the bestiary holds 24 named legends", bst.COUNT == 24);
        // Every legend has a native depth in 1..16 and a power tier in 1..10.
        boolean depthsOk = true; boolean tiersOk = true;
        int bi = 0;
        while (bi < bst.COUNT) {
            int nd = bst.nativeDepth(bi);
            int t = bst.powerTier(bi);
            if (nd < 1 || nd > 16) { depthsOk = false; }
            if (t < 1 || t > 10) { tiersOk = false; }
            bi = bi + 1;
        }
        check("every legend's native depth is in 1..16", depthsOk);
        check("every legend's power tier is in 1..10", tiersOk);

        // Deeper is more experienced: the deepest legends are the deities.
        check("Tiamat is native to the deepest hall (16)",
            bst.nativeDepth(bst.COUNT - 1) == 16);
        check("Tiamat is a top-tier (10) menace",
            bst.powerTier(bst.COUNT - 1) == 10);
        check("Volo (a mortal explorer) is native up top (depth 1)",
            bst.nativeDepth(0) == 1);
        check("a deity out-tiers a mortal explorer",
            bst.powerTier(bst.COUNT - 1) > bst.powerTier(0));

        // The lord of a depth is a legend native to it; depth 16 is a deity.
        int lord16 = bst.lordOfDepth(16);
        check("depth 16 has a lord", lord16 >= 0);
        check("the lord of depth 16 is native to depth 16",
            bst.nativeDepth(lord16) == 16);
        check("the lord of depth 1 is a shallow mortal",
            bst.lordOfDepth(1) >= 0 && bst.nativeDepth(bst.lordOfDepth(1)) == 1);

        // Home vs stray scaling: a legend met at home is at full strength; a
        // stray met far above its home is weaker (fewer HP).
        Legend home = bst.materialize(bst.COUNT - 1, 16);   // Tiamat at home
        Legend stray = bst.materialize(bst.COUNT - 1, 6);   // Tiamat met shallow
        check("a legend at/below home scales to full strength",
            bst.scaleForDepth(bst.COUNT - 1, 16) == 100);
        check("a stray far above home is weakened",
            bst.scaleForDepth(bst.COUNT - 1, 6) < 100);
        check("the weakened stray has fewer HP than the home legend",
            stray.hp < home.hp);
        check("a deity's HP at home is mighty (>= 400)", home.hp >= 400);
        check("a deity reads with a true Character Number (>= 25)",
            home.chr >= 25);

        // The SURFACE (Level 1) is open daylight and holds NO lord; the Mines
        // below do. A fresh hero starts on the surface, lord-free.
        MoriaDungeon surf = new MoriaDungeon();
        surf.begin("Surfacer", 1428);
        check("the hero starts on the surface (Level 1)", surf.isOnSurface());
        check("the surface holds no lord", !surf.hasLord());
        check("the surface is mine-level 0", surf.mineLevel() == 0);

        // --- The Grimoire of Castings: named + class spells ----------------
        MoriaGrimoire gr = new MoriaGrimoire();
        check("the grimoire holds 13 usable castings", gr.GRIMOIRE_COUNT == 13);
        // The specially-named castings are present and named.
        check("Heal is a named casting",
            gr.castName(0) == "Heal" && gr.castNamed(0));
        check("Teleport is a named casting", gr.castName(1) == "Teleport");
        check("Make Short Change is a named casting",
            gr.castName(2) == "Make Short Change");
        check("Cast for Better Wood is a named casting",
            gr.castName(3) == "Cast for Better Wood");
        check("Heal Water is a named casting", gr.castName(4) == "Heal Water");
        check("Demystify Sound is a named casting",
            gr.castName(5) == "Demystify Sound");
        check("Call for Collegiance is a named casting",
            gr.castName(6) == "Call for Collegiance");
        check("the first seven castings are the named ones",
            gr.castNamed(0) && gr.castNamed(6) && !gr.castNamed(7));

        // Fighters get swords for now — no castings. Casters each know some.
        check("Fighters cast nothing (swords only)",
            gr.spellsForClass(gr.CLS_FIGHTER) == 0);
        check("Mages know some castings", gr.spellsForClass(gr.CLS_MAGE) > 0);
        check("Clerics know some castings", gr.spellsForClass(gr.CLS_CLERIC) > 0);
        check("Wizards are the fullest casters",
            gr.spellsForClass(gr.CLS_WIZARD) >= gr.spellsForClass(gr.CLS_MAGE)
            && gr.spellsForClass(gr.CLS_WIZARD) >= gr.spellsForClass(gr.CLS_CLERIC));
        check("a Fighter cannot cast Heal",
            !gr.classCanCast(gr.CLS_FIGHTER, 0));
        check("a Cleric can cast Heal", gr.classCanCast(gr.CLS_CLERIC, 0));
        check("only a Wizard casts Identify",
            gr.classCanCast(gr.CLS_WIZARD, 12)
            && !gr.classCanCast(gr.CLS_MAGE, 12));

        // --- The Lich obedience pact + the Spelling Duo --------------------
        Pact pc = gr.requestPact(20, 0);     // a lich demands a pact, duo #0
        check("a fresh pact is not yet agreed", !pc.agreed);
        gr.agree(pc);
        check("you must Agree first", pc.agreed && !pc.obeyed);
        gr.obey(pc);
        check("Obey pauses the character", gr.pausesCharacter(pc));
        // The Spelling Duo: a WRONG order keeps the hold; the RIGHT order frees.
        check("a wrong-ordered answer does not free you",
            !gr.resolvePact(pc, false));
        check("still paused after a wrong answer", gr.pausesCharacter(pc));
        check("the right order (earlier-before-later) frees you",
            gr.resolvePact(pc, true));
        check("the pause lifts once answered rightly", !gr.pausesCharacter(pc));

        // --- Spell numbers: Heal, Magic Missile, Trick, Fireball/Trick -----
        check("the grimoire now holds 15 castings", gr.GRIMOIRE_COUNT == 15);
        check("Magic Missile is in the grimoire", gr.castName(13) == "Magic Missile");
        check("Trick is in the grimoire", gr.castName(14) == "Trick");
        // Heal = 1d40 + 6 per level. Max die 40 at level 5 => 40 + 30 = 70.
        check("Heal is 1d40 + 6 per level (max die, L5 => 70)",
            gr.healAmount(40, 5) == 70);
        // Magic Missile = 3 x (1d4+1). Max => 15; a fixed set 4,2,3 => 12.
        check("Magic Missile max (4,4,4) == 15", gr.magicMissile(4, 4, 4) == 15);
        check("Magic Missile 4,2,3 == 12", gr.magicMissile(4, 2, 3) == 12);
        // Trick = 1d6 + 6 + 28 per level. Max die 6 at L5 => 6 + 6 + 140 = 152.
        check("Trick is 1d6+6+28/level (max die, L5 => 152)",
            gr.trickAmount(6, 5) == 152);
        // MM then Trick, in that fixed order: 15 + 152 = 167 at L5 maxed.
        check("MM then Trick totals (15 + 152 == 167) at L5",
            gr.missileThenTrick(4, 4, 4, 6, 5) == 167);
        // Fireball past level 6 assumes Trick: a steady +42 HP.
        check("Fireball below level 7 is unchanged",
            gr.fireballWithTrick(50, 5) == 50 && !gr.fireballAssumesTrick(5));
        check("Fireball past level 6 assumes Trick (+42)",
            gr.fireballWithTrick(50, 7) == 92 && gr.fireballAssumesTrick(7));
        // Heal Water rejuvenates Base Constitution at 99.6% of the gap.
        check("Heal Water restores CON to 99.6% of the gap (20->39 of 40)",
            gr.healWaterConstitution(20, 40) == 39);
        check("Heal Water full when already at max", gr.healWaterConstitution(40, 40) == 40);

        // The dungeon's pact pause actually blocks movement.
        MoriaDungeon pd = new MoriaDungeon();
        pd.begin("Bound", 7);
        pd.setHeroClass(gr.CLS_WIZARD);
        check("a Wizard hero knows castings", pd.knownCastings() > 0);
        // Fighters get swords only, even in the dungeon.
        pd.setHeroClass(gr.CLS_FIGHTER);
        check("a Fighter hero knows no castings", pd.knownCastings() == 0);

        // --- The character-creation generator ------------------------------
        MoriaCreator cr = new MoriaCreator();
        cr.begin();

        // The three base-stat allowances all produce a legal character.
        Creature0 rolled = cr.rollBase("Rolled", 1428, 90210, 70300, 31337, 5, 777);
        Creature0 pts = cr.pointSet("Chosen", 16, 14, 14, 12, 13, 15);
        Creature0 old = cr.oldWisdoms("Elder", 40);
        check("rolled allowance is tagged", rolled.allowance == cr.ALLOW_ROLLED);
        check("point-set allowance is tagged", pts.allowance == cr.ALLOW_POINT_SET);
        check("old-wisdoms allowance is tagged", old.allowance == cr.ALLOW_OLD_WISDOMS);
        check("point-set honours the supplied scores",
            pts.str == 16 && pts.wis == 13 && pts.chr == 15);

        // Old Wisdoms: wiser, and reads truer (higher Character Number).
        check("old wisdoms carries a high Wisdom", old.wis >= 18);
        check("old wisdoms carries a high Character Number", old.chr >= 25);
        check("old wisdoms reads fully true (100%)", cr.truthPercent(old) == 100);

        // The snuff — lifetime feats, several won by law — grant bonuses.
        Creature0 d = cr.oldWisdoms("Distinguished", 24);
        int goldBefore = d.gold; int intBefore = d.intel; int wisBefore = d.wis;
        cr.grantFeat(d, cr.FEAT_LAW_DEGREE);
        check("Law Degree is held", cr.hasFeat(d, cr.FEAT_LAW_DEGREE));
        check("Law Degree lifts INT and WIS",
            d.intel > intBefore && d.wis > wisBefore);
        check("Law Degree raises standing", d.standing >= 20);

        cr.grantFeat(d, cr.FEAT_UNI_TRUSTS);
        check("University trusts bring an endowment (more gold)", d.gold > goldBefore + 1000);

        int goldPreWealth = d.gold;
        cr.grantFeat(d, cr.FEAT_GREAT_WEALTH);
        check("Great Wealth adds a fortune", d.gold >= goldPreWealth + 10000);
        // Great Wealth summons 1000x estimable wealth, floored at 20,000.
        check("Great Wealth summons 1000x a 50-coin purse (50000)",
            cr.greatWealthSummon(50) == 50000);
        check("Great Wealth is floored at 20,000 coins",
            cr.greatWealthSummon(5) == 20000);
        // Trusts of Universities moves the Democrat/Socialist track +5 levels.
        check("University trusts advance the political track +5",
            d.politicalLevels == 5);

        int chrPreExc = d.chr;
        cr.grantFeat(d, cr.FEAT_EXCEPTION);
        check("Exception Institute lifts the Character Number",
            d.chr >= chrPreExc);   // (may clamp at 40 if already high)
        check("the distinguished sheet reads fully true", cr.truthPercent(d) == 100);
        // Exception Institute: +1000 temp INT for 5 hours, 2 kingdoms, 2 followers.
        check("Exception grants +1000 temporary INT", d.intTempBonus == 1000);
        check("Exception temp INT lasts 5 hours (300 min)", d.intTempMinutes == 300);
        check("Exception grants 2 kingdoms", d.kingdoms == 2);
        check("Exception grants 2 followers", d.followers == 2);
        check("followers are level-36 NPCs", cr.followerLevel() == 36);
        check("a level-5 summoner holds followers 140 rounds (~min)",
            cr.summonRounds(5) == 140);

        // Endowed Chair: +8000 permanent INT that crumbles over 1000 moves.
        int chairBefore = d.intel;
        cr.grantFeat(d, cr.FEAT_ENDOWED_CHAIR);
        check("Endowed Chair grants an +8000 permanent-INT pool",
            d.intPermBonus == 8000);
        check("the chair pool crumbles with moves and failures",
            cr.chairStanding(d, 1000, 40) < 8000
            && cr.chairStanding(d, 1000, 40) > 0);
        check("effective INT counts the chair pool while it stands",
            cr.effectiveInt(d, cr.chairStanding(d, 1000, 40), 60) > d.intel);
        check("the crumbled chair fades in 1-2 minutes",
            cr.chairFadeMinutes(1428) >= 1 && cr.chairFadeMinutes(1428) <= 2);

        // Granting a feat twice does not double-dip.
        int standBefore = d.standing;
        cr.grantFeat(d, cr.FEAT_LAW_DEGREE);
        check("a feat is not granted twice", d.standing == standBefore);

        // A plain Fighter build with no feats still gets a modest start.
        Creature0 fighter = cr.pointSet("Swordhand", 16, 14, 15, 9, 10, 11);
        check("a feat-less build has starting gold", fighter.gold >= 1);
        check("a feat-less build has zero standing", fighter.standing == 0);

        // The dungeon adopts a created character (stats, gold, standing, feats).
        Creature0 champion = cr.oldWisdoms("Champion", 20);
        cr.grantFeat(champion, cr.FEAT_GREAT_WEALTH);
        cr.grantFeat(champion, cr.FEAT_KNIGHTHOOD);
        MoriaDungeon cd = new MoriaDungeon();
        cd.beginFromCharacter(champion, 1428);
        check("the dungeon adopts the created character's purse",
            cd.goldCount() >= 10000);
        check("the dungeon adopts the created character's standing",
            cd.heroStanding_() > 0);
        check("the dungeon carries the created character's feats",
            cd.heroHasFeat(cr.FEAT_GREAT_WEALTH) && cd.heroHasFeat(cr.FEAT_KNIGHTHOOD));

        // --- The walk animation: start / mid / stop, and the character moves --
        MoriaAnimation an = new MoriaAnimation();
        check("animation samples exactly 3 frames (start/mid/stop)", an.FRAMES == 3);
        Walker wk = an.spawn("adventurer", 2, 9);
        check("a fresh walker is at rest on the STOP frame",
            an.frameOf(wk) == an.FRAME_STOP);
        an.face(wk, 1, 0);
        int startX = wk.x;
        an.step(wk);
        check("one step moves the character one cell (walking)", wk.x == startX + 1);
        check("a walking character is moving", wk.moving);
        check("the walk cycles through the sampled frames",
            an.frameOf(wk) >= an.FRAME_START && an.frameOf(wk) <= an.FRAME_STOP);
        // Walking east faces RIGHT -> the -right sprite.
        check("walking east faces right", an.facing(wk) == "right");
        check("the right-facing frame maps to the -right sprite",
            an.framePath(wk) == "images/adventurer/adventurer-"
                + an.frameLabel(an.frameOf(wk)) + "-right.png");
        // Turn and walk west: faces LEFT -> the mirrored -left sprite.
        an.stepToward(wk, wk.x - 1, wk.y);
        check("walking west faces left", an.facing(wk) == "left");
        check("the left-facing frame maps to the -left sprite",
            an.framePath(wk) == "images/adventurer/adventurer-"
                + an.frameLabel(an.frameOf(wk)) + "-left.png");
        // The facing-neutral base path is still available.
        check("the base (undirected) sprite path is still offered",
            an.frameBasePath(wk) == "images/adventurer/adventurer-"
                + an.frameLabel(an.frameOf(wk)) + ".png");
        an.halt(wk);
        check("halting settles on the STOP frame", an.frameOf(wk) == an.FRAME_STOP);
        // The hero in the live dungeon animates as he walks, left or right.
        check("the hero reports a walk frame", r.heroFrame() != "");
        check("the hero's sprite is a left/right facing under images/adventurer/",
            r.heroSprite() == "images/adventurer/adventurer-start-right.png"
            || r.heroSprite() == "images/adventurer/adventurer-mid-right.png"
            || r.heroSprite() == "images/adventurer/adventurer-stop-right.png"
            || r.heroSprite() == "images/adventurer/adventurer-start-left.png"
            || r.heroSprite() == "images/adventurer/adventurer-mid-left.png"
            || r.heroSprite() == "images/adventurer/adventurer-stop-left.png");

        // --- Gandalf: the four-way directional sprite matrix ----------------
        // top / down / left / right, each with start / mid / end — the sprites
        // under images/gandalf/. The engine resolves each direction + frame to
        // the right file on disk.
        Walker gw = an.spawn("gandalf", 5, 5);
        check("a gandalf walker starts facing right (default)",
            an.facing4(gw) == "right");
        an.stepToward(gw, gw.x, gw.y - 1);   // walk north
        check("walking up faces top", an.facing4(gw) == "top");
        check("the up sprite is a gandalf -top frame",
            an.framePath4(gw) == "images/gandalf/gandalf-"
                + an.frameLabelEnd(an.frameOf(gw)) + "-top.png");
        an.stepToward(gw, gw.x, gw.y + 1);   // walk south
        check("walking down faces down", an.facing4(gw) == "down");
        check("the down sprite is a gandalf -down frame",
            an.framePath4(gw) == "images/gandalf/gandalf-"
                + an.frameLabelEnd(an.frameOf(gw)) + "-down.png");
        an.stepToward(gw, gw.x - 1, gw.y);   // walk west
        check("walking left faces left", an.facing4(gw) == "left");
        an.stepToward(gw, gw.x + 1, gw.y);   // walk east
        check("walking right faces right", an.facing4(gw) == "right");
        // The planted pose is labelled END (the designer's name for STOP).
        check("the END label names the planted pose",
            an.frameLabelEnd(an.FRAME_STOP) == "end");
        // Explicit (frame, direction) sprite paths resolve for all four ways.
        check("gandalf start-top sprite path",
            an.spritePath("gandalf", an.FRAME_START, "top")
                == "images/gandalf/gandalf-start-top.png");
        check("gandalf mid-left sprite path",
            an.spritePath("gandalf", an.FRAME_MID, "left")
                == "images/gandalf/gandalf-mid-left.png");
        check("gandalf end-down sprite path",
            an.spritePath("gandalf", an.FRAME_STOP, "down")
                == "images/gandalf/gandalf-end-down.png");
        check("gandalf end-right sprite path",
            an.spritePath("gandalf", an.FRAME_STOP, "right")
                == "images/gandalf/gandalf-end-right.png");

        // The nested <direction>/<action>/ folder layout resolves too: the four
        // direction folders, each with start/mid/end, carefully filed.
        check("nested top/start folder path",
            an.nestedSpritePath("gandalf", an.FRAME_START, "top")
                == "images/gandalf/top/start/gandalf-top-start.png");
        check("nested left/mid folder path",
            an.nestedSpritePath("gandalf", an.FRAME_MID, "left")
                == "images/gandalf/left/mid/gandalf-left-mid.png");
        check("nested down/end folder path",
            an.nestedSpritePath("gandalf", an.FRAME_STOP, "down")
                == "images/gandalf/down/end/gandalf-down-end.png");
        check("nested right/end folder path",
            an.nestedSpritePath("gandalf", an.FRAME_STOP, "right")
                == "images/gandalf/right/end/gandalf-right-end.png");
        check("the direction folder is named by facing",
            an.directionFolder("gandalf", "left") == "images/gandalf/left/");
        // A walker's current pose resolves in the nested tree as well.
        Walker gn = an.spawn("gandalf", 5, 5);
        an.stepToward(gn, gn.x, gn.y - 1);   // walk up -> top
        check("a walker resolves its nested top sprite",
            an.framePath4Nested(gn) == "images/gandalf/top/"
                + an.frameLabelEnd(an.frameOf(gn)) + "/gandalf-top-"
                + an.frameLabelEnd(an.frameOf(gn)) + ".png");

        // --- The whole cast: each character carries the same sprite set -----
        // gandalf, gimli, frodo, aragorn, moria-goblin — all lowercase, with
        // the goblin hyphenated. Flat and nested paths resolve for each.
        check("gimli flat sprite path",
            an.spritePath("gimli", an.FRAME_MID, "left")
                == "images/gimli/gimli-mid-left.png");
        check("gimli nested sprite path",
            an.nestedSpritePath("gimli", an.FRAME_START, "down")
                == "images/gimli/down/start/gimli-down-start.png");
        check("frodo flat sprite path",
            an.spritePath("frodo", an.FRAME_STOP, "right")
                == "images/frodo/frodo-end-right.png");
        check("frodo nested sprite path",
            an.nestedSpritePath("frodo", an.FRAME_MID, "top")
                == "images/frodo/top/mid/frodo-top-mid.png");
        check("aragorn flat sprite path",
            an.spritePath("aragorn", an.FRAME_START, "top")
                == "images/aragorn/aragorn-start-top.png");
        check("aragorn nested sprite path",
            an.nestedSpritePath("aragorn", an.FRAME_STOP, "left")
                == "images/aragorn/left/end/aragorn-left-end.png");
        check("moria-goblin flat sprite path (hyphenated, lowercase)",
            an.spritePath("moria-goblin", an.FRAME_MID, "down")
                == "images/moria-goblin/moria-goblin-mid-down.png");
        check("moria-goblin nested sprite path",
            an.nestedSpritePath("moria-goblin", an.FRAME_START, "right")
                == "images/moria-goblin/right/start/moria-goblin-right-start.png");
        check("the direction folder for a hyphenated name is lowercase",
            an.directionFolder("moria-goblin", "top") == "images/moria-goblin/top/");

        // --- The 2000+ dungeon catalog, sized for the GUI gameboard ----------
        MoriaDungeonCatalog cat = new MoriaDungeonCatalog();
        check("the catalog names 2000+ dungeons", cat.catalogSize() >= 2000);
        int over = 0; int kc = 0;
        while (kc < 400) {
            int did = kc * 31 + 1;
            Dungeon dg = cat.forge(did);
            // Every board must fit inside the Sleela GUI pane.
            if (dg.boardWidthPx > cat.GUI_PANE_W || dg.boardHeightPx > cat.GUI_PANE_H) {
                over = over + 1;
            }
            kc = kc + 1;
        }
        check("every sampled dungeon board fits the Sleela GUI pane", over == 0);
        Dungeon d0 = cat.forge(777);
        check("a dungeon carries an original authoring size",
            cat.originalWidthPx(d0) > 0 && cat.originalHeightPx(d0) > 0);
        check("a dungeon carries a GUI board size",
            d0.boardWidthPx > 0 && d0.boardHeightPx > 0);
        check("a dungeon carries animation times (a positive stride)",
            cat.strideMs(d0) > 0);

        // --- Persistent levels: down then up returns to the SAME place ------
        // A level is maintained. Descend into the Mines, walk to a known spot,
        // climb back to the surface, then descend again — the hero returns to
        // the exact spot he left on that level, not a re-rolled start.
        MoriaDungeon pz = new MoriaDungeon();
        pz.begin("Pathfinder", 1428);
        check("the hero begins on the surface, mine-level 0",
            pz.isOnSurface() && pz.mineLevel() == 0);
        check("cannot ascend from the surface", !pz.canAscend());

        pz.descendOnce();                       // surface -> first mine level
        check("descending leaves the surface", !pz.isOnSurface());
        check("the first mine level is depth 2", pz.currentDepth() == 2);
        check("the mine level can be ascended from", pz.canAscend());

        // Clear a monster on this level, then leave: the kill must persist when
        // we come back (the level is maintained, not regenerated). Record a
        // changed (cleared) cell so we can confirm it stays cleared.
        int md2 = pz.currentDepth();

        // Climb back to the surface, then descend again into the SAME hall.
        pz.ascendOnce();
        check("ascending returns to the surface", pz.isOnSurface());
        check("the surface is still mine-level 0", pz.mineLevel() == 0);
        int surfReturnX = pz.heroCol();         // where we land on the surface
        int surfReturnY = pz.heroRow();

        pz.descendOnce();                       // down again into the SAME hall
        check("re-descending returns to the same depth",
            pz.currentDepth() == md2);
        int mineReturnX = pz.heroCol();         // where we land back in the mine
        int mineReturnY = pz.heroRow();

        // The level is MAINTAINED: leaving and returning is REPEATABLE — a
        // second ascend/descend lands the hero on exactly the same spots, not a
        // re-rolled position, in both directions.
        pz.ascendOnce();
        check("ascent is repeatable — same surface spot each time",
            pz.heroCol() == surfReturnX && pz.heroRow() == surfReturnY);
        pz.descendOnce();
        check("descent is repeatable — same mine spot each time (level maintained)",
            pz.heroCol() == mineReturnX && pz.heroRow() == mineReturnY);
        check("the maintained hall keeps its depth across the round trip",
            pz.currentDepth() == md2);

        // --- Depth-scaled difficulty: deeper creatures are harder -----------
        // Monster counterattack, defence, and toughness all rise with the mine
        // depth, so the deep halls are far more dangerous than the first.
        MoriaDungeon df = new MoriaDungeon();
        df.begin("Delver", 1428);
        int orcThreatShallow = df.orcThreatAtMineLevel(1);
        int orcThreatDeep    = df.orcThreatAtMineLevel(6);
        check("a deeper orc hits harder than a shallow one",
            orcThreatDeep > orcThreatShallow);
        int trollShallow = df.trollThreatAtMineLevel(2);
        int trollDeep    = df.trollThreatAtMineLevel(7);
        check("a deeper troll hits harder than a shallow one",
            trollDeep > trollShallow);
        check("a troll hits harder than an orc at the same depth",
            df.trollThreatAtMineLevel(4) > df.orcThreatAtMineLevel(4));
        check("monster defence rises with depth",
            df.orcDefenceAtMineLevel(6) > df.orcDefenceAtMineLevel(1));
        check("monster toughness rises with depth",
            df.orcToughnessAtMineLevel(6) > df.orcToughnessAtMineLevel(1));
        check("the surface holds no hostile creatures (threat/toughness are mild)",
            df.orcThreatAtMineLevel(0) >= 0);

        print("");
        print("Moria self-check: " + passed + " passed, " + failed + " failed.");
        if (failed == 0) {
            print("All clear. Levels persist, the surface is safe, and the deep "
                + "bites harder.");
        }
    }
}
